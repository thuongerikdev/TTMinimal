@model List<AddonModel>

@{
    ViewBag.Title = T("Plugins.Split3D.Addons").Value;
}

<div class="section-header">
    <div class="title">
        <i class="bi bi-boxes"></i>
        @T("Plugins.Split3D.Addons")
    </div>
    <div class="options">
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fa fa-plus"></i>
            <span>@T("Plugins.Split3D.Addon.Add")</span>
        </a>
        <a href="@Url.Action("List", "Split3D")" class="btn btn-secondary">
            <i class="bi bi-key"></i>
            <span>@T("Plugins.Split3D.Licenses")</span>
        </a>
    </div>
</div>

<div class="alert alert-info">@Html.Raw(T("Plugins.Split3D.Addons.Hint"))</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@T("Plugins.Split3D.Addon.Name")</th>
                    <th>@T("Plugins.Split3D.Addon.ProductCode")</th>
                    <th>@T("Plugins.Split3D.Addon.Version")</th>
                    <th class="text-center">@T("Plugins.Split3D.Addon.Products")</th>
                    <th class="text-center">@T("Plugins.Split3D.Stats.Transactions")</th>
                    <th class="text-center">@T("Plugins.Split3D.Addon.Active")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-muted">@T("Plugins.Split3D.Addons.None")</td></tr>
                }
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="font-weight-bold"><a href="@Url.Action("Edit", new { id = a.Id })">@a.Name</a>
                            @if (a.ComingSoon)
                            {
                                <span class="badge badge-warning ml-1">@T("Plugins.Split3D.Addon.ComingSoon")</span>
                            }
                        </td>
                        <td><code>@a.ProductCode</code></td>
                        <td>@a.Version</td>
                        <td class="text-center">@a.ProductCount</td>
                        <td class="text-center">@a.LicenseCount</td>
                        <td class="text-center">
                            @if (a.Active)
                            {
                                <i class="fa fa-check text-success"></i>
                            }
                            else
                            {
                                <i class="fa fa-times text-muted"></i>
                            }
                        </td>
                        <td class="text-right text-nowrap">
                            <a href="@Url.Action("Edit", new { id = a.Id })" class="btn btn-sm btn-secondary">@T("Common.Edit")</a>
                            <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger confirm2"
                                        data-confirm-message="@T("Plugins.Split3D.Addon.DeleteConfirm", a.Name)">
                                    <i class="far fa-trash-can"></i>
                                    <span>@T("Common.Delete")</span>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
