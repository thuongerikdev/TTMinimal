@model AddonModel

@{
    var isNew = Model.Id == 0;
    ViewBag.Title = isNew ? T("Plugins.Split3D.Addon.Add").Value : Model.Name;
}

<div class="section-header">
    <div class="title">
        <a sm-backto href="@Url.Action("List")"></a>
        <i class="bi bi-box"></i>
        @ViewBag.Title
    </div>
    <div class="options">
        <button type="submit" form="addon-form" class="btn btn-warning">
            <i class="fa fa-check"></i>
            <span>@T("Admin.Common.Save")</span>
        </button>
        @if (!isNew)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-danger confirm2"
                        data-confirm-message="@T("Plugins.Split3D.Addon.DeleteConfirm", Model.Name)">
                    <i class="far fa-trash-can"></i>
                    <span>@T("Admin.Common.Delete")</span>
                </button>
            </form>
        }
    </div>
</div>

<form asp-action="Save" method="post" id="addon-form">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All"></div>
    <div class="adminContent">
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="Name" /></div>
            <div class="adminData"><input asp-for="Name" placeholder="Split3D Texture" /><span asp-validation-for="Name"></span></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="ProductCode" /></div>
            <div class="adminData">
                <input asp-for="ProductCode" class="text-monospace" placeholder="split3d-texture" />
                <span asp-validation-for="ProductCode"></span>
                <div class="form-text text-muted">@Html.Raw(T("Plugins.Split3D.Addon.ProductCodeNote"))</div>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="Version" /></div>
            <div class="adminData"><input asp-for="Version" placeholder="1.0.0" /><span asp-validation-for="Version"></span></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="Description" /></div>
            <div class="adminData"><textarea asp-for="Description" rows="6" class="form-control"></textarea></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="Active" /></div>
            <div class="adminData"><input asp-for="Active" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="ManagedLicensing" /></div>
            <div class="adminData"><input asp-for="ManagedLicensing" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="DisplayOrder" /></div>
            <div class="adminData"><input asp-for="DisplayOrder" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="ComingSoon" /></div>
            <div class="adminData"><input asp-for="ComingSoon" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="Kind" /></div>
            <div class="adminData"><input asp-for="Kind" placeholder="Addon Blender" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="Icon" /></div>
            <div class="adminData">
                <select asp-for="Icon" class="form-control">
                    <option value=""></option>
                    @foreach (var name in StudioIcons.Names.Where(x => x != "facebook"))
                    {
                        <option value="@name" selected="@(name == Model.Icon)">@name</option>
                    }
                </select>
            </div>
        </div>
    </div>
</form>

@if (!isNew)
{
    <div class="card mt-4">
        <div class="card-header font-weight-bold">
            <i class="bi bi-tags mr-1"></i>
            @T("Plugins.Split3D.Addon.Products") (@Model.Products.Count) · @Model.LicenseCount key
        </div>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>@T("Plugins.Split3D.Addon.Product")</th>
                        <th>SKU</th>
                        <th>@T("Plugins.Split3D.License.KeyType")</th>
                        <th class="text-right">@T("Plugins.Split3D.License.Price")</th>
                        <th>@T("Plugins.Split3D.Addon.FileVersions")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Products.Count == 0)
                    {
                        <tr><td colspan="6" class="text-muted">@T("Plugins.Split3D.Addon.NoProducts")</td></tr>
                    }
                    @foreach (var p in Model.Products)
                    {
                        <tr>
                            <td>
                                <a href="@p.EditUrl">@p.ProductName</a>
                                @if (!p.Published)
                                {
                                    <span class="badge badge-secondary ml-1">@T("Plugins.Split3D.Addon.Unpublished")</span>
                                }
                            </td>
                            <td><code>@p.Sku</code></td>
                            <td>@p.KeyType@(p.Days.HasValue ? $" ({p.Days})" : "")@(p.MaxDevices.HasValue ? $" · {p.MaxDevices} máy" : "")</td>
                            <td class="text-right">@p.Price</td>
                            <td>
                                @if (p.DownloadVersions.HasValue())
                                {
                                    @p.DownloadVersions
                                }
                                else
                                {
                                    <span class="text-danger">@T("Plugins.Split3D.Addon.NoFile")</span>
                                }
                            </td>
                            <td class="text-right">
                                <form asp-action="UnmapProduct" asp-route-id="@p.MappingId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('@T("Plugins.Split3D.Addon.UnmapConfirm")')">@T("Plugins.Split3D.Addon.Unmap")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-magic mr-1"></i>@T("Plugins.Split3D.Addon.CreateProducts")</h5>
                    <p class="text-muted small">@T("Plugins.Split3D.Addon.CreateProductsHint")</p>
                    <form asp-action="CreatePlanProducts" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="AddonId" value="@Model.Id" />
                        <table class="table table-sm table-borderless mb-2">
                            @foreach (var (field, label, price) in new[] { ("ThreeMonths", Split3DPlans.ThreeMonths, 150000), ("SixMonths", Split3DPlans.SixMonths, 250000), ("OneYear", Split3DPlans.OneYear, 450000), ("Lifetime", Split3DPlans.Lifetime, 900000) })
                            {
                                <tr>
                                    <td class="align-middle">
                                        <label class="mb-0"><input type="checkbox" name="@field" value="true" checked class="mr-1" /> @label</label>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <input type="number" name="@(field)Price" value="@price" min="0" step="1000" class="form-control" />
                                            <div class="input-group-append"><span class="input-group-text">₫</span></div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </table>
                        <div class="form-group">
                            <label class="small font-weight-medium">Số máy mỗi key (gói theo số máy)</label>
                            <input type="number" name="MaxDevices" min="1" max="100" class="form-control form-control-sm" placeholder="Để trống = mặc định" />
                            <small class="form-text text-muted">Nhập 5 để tạo bộ gói "· 5 máy" (sản phẩm riêng, giá riêng). Chạy lại với số máy khác để thêm bộ gói khác.</small>
                        </div>
                        <div class="form-group">
                            <label class="small font-weight-medium">@T("Plugins.Split3D.Addon.ZipFile")</label>
                            <input type="file" name="addonfile" accept=".zip" class="form-control form-control-sm" />
                        </div>
                        <div class="form-group">
                            <label class="small font-weight-medium">@T("Plugins.Split3D.Addon.ImageFile")</label>
                            <input type="file" name="imagefile" accept=".png,.jpg,.jpeg,.webp" class="form-control form-control-sm" />
                        </div>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-magic"></i> @T("Plugins.Split3D.Addon.CreateProducts")</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-cloud-upload mr-1"></i>@T("Plugins.Split3D.Addon.UploadVersion")</h5>
                    <p class="text-muted small">@T("Plugins.Split3D.Addon.UploadVersionHint")</p>
                    @if (Model.ManagedLicensing)
                    {
                        <p class="small mb-2"><i class="bi bi-shield-check text-success"></i> Sàn quản lý bản quyền: chỉ cần file addon có tính năng — shop tự gắn phần nhập key, kiểm tra online, nút cập nhật và mã hoá.</p>
                    }
                    <form asp-action="UploadVersion" method="post" enctype="multipart/form-data" class="s3d-upload-form">
                        <input type="hidden" name="addonId" value="@Model.Id" />
                        @* Drop zone: the file input covers the whole box, so dropping a zip anywhere on it selects the file. *@
                        <label class="s3d-drop">
                            <input type="file" name="addonfile" accept=".zip" required />
                            <i class="bi bi-file-earmark-zip"></i>
                            <b>Kéo file addon (.zip) vào đây</b>
                            <span class="s3d-drop-name">hoặc bấm để chọn file</span>
                        </label>
                        <div class="form-row mt-2">
                            <div class="col-5"><input type="text" name="version" class="form-control form-control-sm" placeholder="@T("Plugins.Split3D.Addon.VersionAuto")" /></div>
                            <div class="col-7"><button type="submit" class="btn btn-primary btn-block"><i class="bi bi-cloud-upload"></i> @T("Plugins.Split3D.Addon.UploadVersion")</button></div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-link-45deg mr-1"></i>@T("Plugins.Split3D.Addon.MapExisting")</h5>
                    <p class="text-muted small">@T("Plugins.Split3D.Addon.MapExistingHint")</p>
                    <form asp-action="MapProduct" method="post">
                        <input type="hidden" name="AddonId" value="@Model.Id" />
                        <div class="form-group">
                            <select name="ProductId" asp-items="ViewBag.AvailableProducts" class="form-control form-control-sm">
                                <option value="0">--</option>
                            </select>
                        </div>
                        <div class="form-row">
                            <div class="col-7"><select name="KeyType" asp-items="ViewBag.AvailableKeyTypes" class="form-control form-control-sm"></select></div>
                            <div class="col-5"><input type="number" name="Days" min="1" max="36500" class="form-control form-control-sm" placeholder="@T("Plugins.Split3D.License.Days")" /></div>
                        </div>
                        <input type="number" name="MaxDevices" min="1" max="100" class="form-control form-control-sm mt-2" placeholder="Số máy mỗi key (trống = mặc định)" />
                        <button type="submit" class="btn btn-secondary mt-2"><i class="bi bi-link-45deg"></i> @T("Plugins.Split3D.Addon.MapExisting")</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .s3d-drop { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; min-height: 140px; margin: 0; padding: 18px; text-align: center; cursor: pointer; border: 2px dashed currentColor; border-radius: 14px; background: rgba(255, 227, 72, .25); transition: background .2s; }
    .s3d-drop:hover, .s3d-drop.is-over { background: rgba(255, 103, 188, .25); }
    .s3d-drop input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
    .s3d-drop i { font-size: 2rem; }
    .s3d-drop-name { font-size: .85rem; opacity: .75; word-break: break-all; }
</style>

<script sm-target-zone="scripts" data-origin="split3d-addon-drop">
    $(function () {
        $('.s3d-drop').each(function () {
            var zone = this, input = zone.querySelector('input'), name = zone.querySelector('.s3d-drop-name');
            ['dragenter', 'dragover'].forEach(function (t) { zone.addEventListener(t, function () { zone.classList.add('is-over'); }); });
            ['dragleave', 'drop'].forEach(function (t) { zone.addEventListener(t, function () { zone.classList.remove('is-over'); }); });
            input.addEventListener('change', function () {
                var f = input.files && input.files[0];
                name.textContent = f ? f.name + ' · ' + (f.size / 1048576).toFixed(1) + ' MB' : 'hoặc bấm để chọn file';
            });
        });
    });
</script>
