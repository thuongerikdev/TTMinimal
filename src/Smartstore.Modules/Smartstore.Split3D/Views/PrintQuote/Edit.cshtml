@model PrintQuoteModel

@{
    ViewBag.Title = T("Plugins.Split3D.PrintQuote.Title", Model.Id).Value;
    var statuses = (List<(int Id, string Name)>)ViewBag.Statuses;
}

<div class="section-header">
    <div class="title">
        <a sm-backto href="@Url.Action("List")"></a>
        <i class="bi bi-printer"></i>
        @ViewBag.Title
        <span class="badge @Model.StatusBadge ml-2">@Model.StatusName</span>
    </div>
    <div class="options">
        <button type="submit" form="printquote-delete-form" class="btn btn-danger"
                onclick="return confirm('@T("Admin.Common.AreYouSure")')">
            <i class="far fa-trash-alt"></i>
            <span>@T("Admin.Common.Delete")</span>
        </button>
        <button type="submit" form="printquote-form" class="btn btn-warning">
            <i class="fa fa-check"></i>
            <span>@T("Admin.Common.Save")</span>
        </button>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" id="printquote-delete-form"></form>

<div class="row">
    <div class="col-lg-7 mb-4">
        <div class="card">
            <div class="card-header font-weight-bold"><i class="bi bi-person mr-1"></i> @T("Plugins.Split3D.PrintQuote.Request")</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4"><smart-label asp-for="CreatedOn" /></dt>
                    <dd class="col-sm-8">@Model.CreatedOn.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4"><smart-label asp-for="Name" /></dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4"><smart-label asp-for="Phone" /></dt>
                    <dd class="col-sm-8">
                        <a href="tel:@Model.Phone">@Model.Phone</a>
                        <a class="ml-2 small" href="https://zalo.me/@(new string((Model.Phone ?? "").Where(char.IsDigit).ToArray()))" target="_blank" rel="noopener">Zalo</a>
                    </dd>

                    @if (Model.Email.HasValue())
                    {
                        <dt class="col-sm-4"><smart-label asp-for="Email" /></dt>
                        <dd class="col-sm-8"><a href="mailto:@Model.Email">@Model.Email</a></dd>
                    }

                    <dt class="col-sm-4"><smart-label asp-for="Technology" /></dt>
                    <dd class="col-sm-8">@Model.Technology.NaIfEmpty()</dd>

                    <dt class="col-sm-4"><smart-label asp-for="Material" /></dt>
                    <dd class="col-sm-8">@Model.Material.NaIfEmpty()</dd>

                    <dt class="col-sm-4"><smart-label asp-for="Quantity" /></dt>
                    <dd class="col-sm-8">@Model.Quantity</dd>

                    <dt class="col-sm-4"><smart-label asp-for="EstimatedGrams" /></dt>
                    <dd class="col-sm-8">@(Model.EstimatedGrams.HasValue ? Model.EstimatedGrams.Value.ToString("N0") + " g" : "-")</dd>

                    @if (Model.EstimatedPrice.HasValue())
                    {
                        <dt class="col-sm-4"><smart-label asp-for="EstimatedPrice" /></dt>
                        <dd class="col-sm-8">@Model.EstimatedPrice</dd>
                    }

                    <dt class="col-sm-4"><smart-label asp-for="NeedsDesign" /></dt>
                    <dd class="col-sm-8">@(Model.NeedsDesign ? T("Admin.Common.Yes") : T("Admin.Common.No"))</dd>

                    <dt class="col-sm-4"><smart-label asp-for="FileName" /></dt>
                    <dd class="col-sm-8">
                        @if (Model.HasFile)
                        {
                            <a href="@Model.DownloadUrl" class="btn btn-sm btn-primary">
                                <i class="bi bi-download"></i>
                                <span>@Model.FileName (@Model.FileSize)</span>
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </dd>

                    @if (Model.FileLink.HasValue())
                    {
                        <dt class="col-sm-4"><smart-label asp-for="FileLink" /></dt>
                        <dd class="col-sm-8 text-break"><a href="@Model.FileLink" target="_blank" rel="noopener noreferrer">@Model.FileLink</a></dd>
                    }

                    @if (Model.Note.HasValue())
                    {
                        <dt class="col-sm-4"><smart-label asp-for="Note" /></dt>
                        <dd class="col-sm-8" style="white-space:pre-wrap">@Model.Note</dd>
                    }

                    @if (Model.IpAddress.HasValue())
                    {
                        <dt class="col-sm-4 text-muted small">IP</dt>
                        <dd class="col-sm-8 text-muted small">@Model.IpAddress</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-5 mb-4">
        <form asp-action="Edit" method="post" id="printquote-form" class="card">
            <input type="hidden" asp-for="Id" />
            <div class="card-header font-weight-bold"><i class="bi bi-pencil-square mr-1"></i> @T("Plugins.Split3D.PrintQuote.Processing")</div>
            <div class="card-body">
                <div class="form-group">
                    <smart-label asp-for="StatusId" />
                    <select asp-for="StatusId" class="form-control">
                        @foreach (var status in statuses)
                        {
                            <option value="@status.Id" selected="@(status.Id == Model.StatusId)">@status.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <smart-label asp-for="QuotedPrice" />
                    <input asp-for="QuotedPrice" class="form-control" type="number" step="1000" min="0" />
                </div>
                <div class="form-group mb-0">
                    <smart-label asp-for="AdminNote" />
                    <textarea asp-for="AdminNote" rows="6" class="form-control"></textarea>
                </div>
            </div>
        </form>
    </div>
</div>
