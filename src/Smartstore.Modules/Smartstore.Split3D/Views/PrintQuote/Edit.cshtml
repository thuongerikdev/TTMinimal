@model PrintQuoteModel

@{
    ViewBag.Title = T("Plugins.Split3D.PrintQuote.Title", Model.Id).Value;
    var statuses = (List<(int Id, string Name)>)ViewBag.Statuses;
    var channels = (List<(int Id, string Name)>)ViewBag.Channels;
    var hasPhone = Model.Phone.HasValue();
}

<div class="section-header">
    <div class="title">
        <a sm-backto href="@Url.Action("List")"></a>
        <i class="bi bi-printer"></i>
        @ViewBag.Title
        <span class="badge @Model.StatusBadge ml-2">@Model.StatusName</span>
    </div>
    <div class="options">
        <button type="submit" form="printquote-delete-form" class="btn btn-danger"
                onclick="return confirm('@T("Admin.Common.AreYouSure")')">
            <i class="far fa-trash-alt"></i>
            <span>@T("Admin.Common.Delete")</span>
        </button>
        <button type="submit" form="printquote-form" class="btn btn-warning">
            <i class="fa fa-check"></i>
            <span>@T("Admin.Common.Save")</span>
        </button>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" id="printquote-delete-form"></form>

<div class="row">
    <div class="col-lg-7 mb-4">
        <div class="card">
            <div class="card-header font-weight-bold"><i class="bi bi-person mr-1"></i> @T("Plugins.Split3D.PrintQuote.Request")</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4"><smart-label asp-for="CreatedOn" /></dt>
                    <dd class="col-sm-8">@Model.CreatedOn.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4"><smart-label asp-for="Name" /></dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4"><smart-label asp-for="Phone" /></dt>
                    <dd class="col-sm-8">
                        <a href="tel:@Model.Phone">@Model.Phone</a>
                        <a class="ml-2 small" href="https://zalo.me/@(new string((Model.Phone ?? "").Where(char.IsDigit).ToArray()))" target="_blank" rel="noopener">Zalo</a>
                    </dd>

                    @if (Model.Email.HasValue())
                    {
                        <dt class="col-sm-4"><smart-label asp-for="Email" /></dt>
                        <dd class="col-sm-8"><a href="mailto:@Model.Email">@Model.Email</a></dd>
                    }

                    <dt class="col-sm-4"><smart-label asp-for="Technology" /></dt>
                    <dd class="col-sm-8">@Model.Technology.NaIfEmpty()</dd>

                    <dt class="col-sm-4"><smart-label asp-for="Material" /></dt>
                    <dd class="col-sm-8">@Model.Material.NaIfEmpty()</dd>

                    <dt class="col-sm-4"><smart-label asp-for="Quantity" /></dt>
                    <dd class="col-sm-8">@Model.Quantity</dd>

                    <dt class="col-sm-4"><smart-label asp-for="EstimatedGrams" /></dt>
                    <dd class="col-sm-8">@(Model.EstimatedGrams.HasValue ? Model.EstimatedGrams.Value.ToString("N0") + " g" : "-")</dd>

                    @if (Model.EstimatedPrice.HasValue())
                    {
                        <dt class="col-sm-4"><smart-label asp-for="EstimatedPrice" /></dt>
                        <dd class="col-sm-8">@Model.EstimatedPrice</dd>
                    }

                    <dt class="col-sm-4"><smart-label asp-for="NeedsDesign" /></dt>
                    <dd class="col-sm-8">@(Model.NeedsDesign ? T("Admin.Common.Yes") : T("Admin.Common.No"))</dd>

                    <dt class="col-sm-4"><smart-label asp-for="FileName" /></dt>
                    <dd class="col-sm-8">
                        @if (Model.HasFile)
                        {
                            <a href="@Model.DownloadUrl" class="btn btn-sm btn-primary">
                                <i class="bi bi-download"></i>
                                <span>@Model.FileName (@Model.FileSize)</span>
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </dd>

                    @if (Model.FileLink.HasValue())
                    {
                        <dt class="col-sm-4"><smart-label asp-for="FileLink" /></dt>
                        <dd class="col-sm-8 text-break"><a href="@Model.FileLink" target="_blank" rel="noopener noreferrer">@Model.FileLink</a></dd>
                    }

                    @if (Model.Note.HasValue())
                    {
                        <dt class="col-sm-4"><smart-label asp-for="Note" /></dt>
                        <dd class="col-sm-8" style="white-space:pre-wrap">@Model.Note</dd>
                    }

                    @if (Model.IpAddress.HasValue())
                    {
                        <dt class="col-sm-4 text-muted small">IP</dt>
                        <dd class="col-sm-8 text-muted small">@Model.IpAddress</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-5 mb-4">
        @* Contact the customer: every button opens the channel and logs the attempt in one click. *@
        <div class="card mb-3">
            <div class="card-header font-weight-bold">
                <i class="bi bi-chat-dots mr-1"></i> @T("Plugins.Split3D.PrintQuote.ContactCustomer")
                @if (Model.ContactCount > 0)
                {
                    <span class="badge badge-secondary ml-1" data-tt-contact-count>@Model.ContactCount</span>
                }
                @if (Model.IsDue)
                {
                    <span class="badge badge-danger ml-1">@T("Plugins.Split3D.PrintQuote.Due")</span>
                }
            </div>
            <div class="card-body">
                <div class="tt-contact-actions mb-3" data-tt-contact="@Url.Action("LogContact")" data-tt-id="@Model.Id">
                    @if (hasPhone)
                    {
                        <a class="btn btn-primary btn-sm mr-1 mb-1" href="@Model.TelUrl" data-tt-channel="@((int)PrintContactChannel.Phone)">
                            <i class="bi bi-telephone"></i> <span>@T("Plugins.Split3D.PrintQuote.Channel.Phone")</span>
                        </a>
                        <a class="btn btn-info btn-sm mr-1 mb-1" href="@Model.ZaloUrl" target="_blank" rel="noopener" data-tt-channel="@((int)PrintContactChannel.Zalo)">
                            <i class="bi bi-chat-dots"></i> <span>Zalo</span>
                        </a>
                        <a class="btn btn-secondary btn-sm mr-1 mb-1" href="@Model.SmsUrl" data-tt-channel="@((int)PrintContactChannel.Sms)">
                            <i class="bi bi-chat-text"></i> <span>SMS</span>
                        </a>
                    }
                    @if (Model.MessengerUrl.HasValue())
                    {
                        <a class="btn btn-secondary btn-sm mr-1 mb-1" href="@Model.MessengerUrl" target="_blank" rel="noopener" data-tt-channel="@((int)PrintContactChannel.Facebook)">
                            <i class="bi bi-messenger"></i> <span>Messenger</span>
                        </a>
                    }
                    @if (Model.MailUrl.HasValue())
                    {
                        <a class="btn btn-secondary btn-sm mr-1 mb-1" href="@Model.MailUrl" data-tt-channel="@((int)PrintContactChannel.Email)">
                            <i class="bi bi-envelope"></i> <span>Email</span>
                        </a>
                    }
                </div>

                <div class="form-group">
                    <label>@T("Plugins.Split3D.PrintQuote.MessagePreview")</label>
                    <textarea rows="4" class="form-control" data-tt-message>@Model.Message</textarea>
                    <div class="d-flex justify-content-between mt-1">
                        <span class="form-text text-muted mt-0">@T("Plugins.Split3D.PrintQuote.MessageHint")</span>
                        <button type="button" class="btn btn-sm btn-light" data-tt-copy>
                            <i class="bi bi-clipboard"></i> <span>@T("Plugins.Split3D.PrintQuote.CopyMessage")</span>
                        </button>
                    </div>
                </div>

                <form asp-action="LogContact" method="post" class="border-top pt-3">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <div class="form-row">
                        <div class="col-5 form-group">
                            <label>@T("Plugins.Split3D.PrintQuote.Fields.Channel")</label>
                            <select name="ChannelId" class="form-control form-control-sm">
                                @foreach (var channel in channels)
                                {
                                    <option value="@channel.Id" selected="@(channel.Id == (int)PrintContactChannel.Phone)">@channel.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-7 form-group">
                            <label>@T("Plugins.Split3D.PrintQuote.FollowUpIn")</label>
                            <select name="FollowUpDays" class="form-control form-control-sm">
                                <option value="">@T("Plugins.Split3D.PrintQuote.FollowUpKeep")</option>
                                <option value="1">1 @T("Plugins.Split3D.PrintQuote.Days")</option>
                                <option value="2">2 @T("Plugins.Split3D.PrintQuote.Days")</option>
                                <option value="3">3 @T("Plugins.Split3D.PrintQuote.Days")</option>
                                <option value="7">7 @T("Plugins.Split3D.PrintQuote.Days")</option>
                                <option value="0">@T("Plugins.Split3D.PrintQuote.FollowUpNone")</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>@T("Plugins.Split3D.PrintQuote.Fields.ContactMessage")</label>
                        <textarea name="Message" rows="2" class="form-control form-control-sm"
                                  placeholder="@T("Plugins.Split3D.PrintQuote.ContactMessagePlaceholder")"></textarea>
                    </div>
                    <div class="form-group form-check">
                        <input type="checkbox" class="form-check-input" id="isIncoming" name="IsIncoming" value="true" />
                        <input type="hidden" name="IsIncoming" value="false" />
                        <label class="form-check-label" for="isIncoming">@T("Plugins.Split3D.PrintQuote.IsIncoming")</label>
                    </div>
                    <button type="submit" class="btn btn-sm btn-secondary">
                        <i class="bi bi-journal-plus"></i> <span>@T("Plugins.Split3D.PrintQuote.LogContact")</span>
                    </button>
                </form>
            </div>
        </div>

        @* Turn the request into a print job the customer pays for. *@
        <div class="card mb-3">
            <div class="card-header font-weight-bold"><i class="bi bi-box-seam mr-1"></i> @T("Plugins.Split3D.PrintQuote.CreateOrder")</div>
            <div class="card-body">
                @if (Model.PrintOrderUrl.HasValue())
                {
                    <p class="mb-2">
                        <a href="@Model.PrintOrderUrl" class="font-weight-medium">@Model.PrintOrderCode</a>
                        <span class="text-muted">· @Model.PrintOrderStatusName</span>
                    </p>
                }
                @if (Model.PayUrl.HasValue())
                {
                    <div class="form-group">
                        <label>@T("Plugins.Split3D.PrintJob.PayLink")</label>
                        <input type="text" class="form-control form-control-sm" readonly value="@Model.PayUrl"
                               onclick="this.select();document.execCommand('copy');" />
                        <span class="form-text text-muted">@T("Plugins.Split3D.PrintJob.PayLinkHint")</span>
                    </div>
                }
                <form asp-action="CreateOrder" method="post">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <div class="form-row">
                        <div class="col-7 form-group">
                            <label>@T("Plugins.Split3D.PrintQuote.Fields.QuotedPrice")</label>
                            <input type="number" name="Price" class="form-control form-control-sm" step="1000" min="0"
                                   value="@(Model.QuotedPrice ?? 0)" />
                        </div>
                        <div class="col-5 form-group">
                            <label>@T("Plugins.Split3D.PrintQuote.Fields.DepositPercent")</label>
                            <input type="number" name="DepositPercent" class="form-control form-control-sm" min="1" max="100"
                                   value="@ViewBag.DepositPercent" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-circle"></i> <span>@T("Plugins.Split3D.PrintQuote.CreateOrderButton")</span>
                    </button>
                    <span class="form-text text-muted">@T("Plugins.Split3D.PrintQuote.CreateOrderHint")</span>
                </form>
            </div>
        </div>

        <form asp-action="Edit" method="post" id="printquote-form" class="card">
            <input type="hidden" asp-for="Id" />
            <div class="card-header font-weight-bold"><i class="bi bi-pencil-square mr-1"></i> @T("Plugins.Split3D.PrintQuote.Processing")</div>
            <div class="card-body">
                <div class="form-group">
                    <smart-label asp-for="StatusId" />
                    <select asp-for="StatusId" class="form-control">
                        @foreach (var status in statuses)
                        {
                            <option value="@status.Id" selected="@(status.Id == Model.StatusId)">@status.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <smart-label asp-for="QuotedPrice" />
                    <input asp-for="QuotedPrice" class="form-control" type="number" step="1000" min="0" />
                </div>
                <div class="form-group">
                    <smart-label asp-for="FollowUpOn" />
                    <input asp-for="FollowUpOn" class="form-control" type="date" />
                    @if (Model.LastContactOn.HasValue)
                    {
                        <span class="form-text text-muted">
                            @T("Plugins.Split3D.PrintQuote.LastContact", Model.LastContactOn.Value.ToString("dd/MM/yyyy HH:mm"))
                        </span>
                    }
                </div>
                <div class="form-group mb-0">
                    <smart-label asp-for="AdminNote" />
                    <textarea asp-for="AdminNote" rows="6" class="form-control"></textarea>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.ContactLog.Count > 0)
{
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card">
                <div class="card-header font-weight-bold"><i class="bi bi-journal-text mr-1"></i> @T("Plugins.Split3D.PrintQuote.ContactLog")</div>
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th style="width:160px">@T("Plugins.Split3D.PrintQuote.Fields.CreatedOn")</th>
                            <th style="width:150px">@T("Plugins.Split3D.PrintQuote.Fields.Channel")</th>
                            <th>@T("Plugins.Split3D.PrintQuote.Fields.ContactMessage")</th>
                            <th style="width:180px">@T("Plugins.Split3D.PrintQuote.LoggedBy")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.ContactLog)
                        {
                            <tr>
                                <td>@entry.CreatedOn.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <i class="bi @entry.ChannelIcon mr-1"></i>@entry.ChannelName
                                    @if (entry.IsIncoming)
                                    {
                                        <span class="badge badge-light ml-1">@T("Plugins.Split3D.PrintQuote.Incoming")</span>
                                    }
                                </td>
                                <td style="white-space:pre-wrap">@entry.Message</td>
                                <td class="text-muted small">@entry.UserName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
