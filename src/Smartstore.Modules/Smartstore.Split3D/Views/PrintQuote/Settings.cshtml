@model StudioConfigurationModel

@{
    ViewBag.Title = T("Plugins.Split3D.Studio.Settings").Value;
}

<div class="section-header">
    <div class="title">
        <i class="bi bi-shop"></i>
        @ViewBag.Title
    </div>
    <div class="options">
        <a href="@Url.Action("List")" class="btn btn-secondary">
            <i class="bi bi-printer"></i>
            <span>@T("Plugins.Split3D.Studio.Quotes")</span>
        </a>
        <button type="submit" form="studio-settings-form" class="btn btn-warning">
            <i class="fa fa-check"></i>
            <span>@T("Admin.Common.Save")</span>
        </button>
    </div>
</div>

<div class="alert @(Model.LayoutVersion >= Model.CurrentLayoutVersion ? "alert-info" : "alert-warning") d-flex flex-wrap align-items-center">
    <span class="mr-3">@T("Plugins.Split3D.Studio.LayoutStatus", Model.LayoutVersion, Model.CurrentLayoutVersion)</span>
    <form asp-action="ApplyLayout" method="post" class="ml-auto" onsubmit="return confirm('@T("Plugins.Split3D.Studio.ApplyLayout.Confirm")')">
        <button type="submit" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-magic"></i>
            <span>@T("Plugins.Split3D.Studio.ApplyLayout")</span>
        </button>
    </form>
</div>

<form asp-action="Settings" method="post" id="studio-settings-form">
    <div asp-validation-summary="All"></div>

    <div class="adminContent">
        <div class="adminRow">
            <div class="admin-config-group"><div class="title">@T("Plugins.Split3D.Studio.Group.Contact")</div></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="BrandName" /></div>
            <div class="adminData"><input asp-for="BrandName" /><span asp-validation-for="BrandName"></span></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="Tagline" /></div>
            <div class="adminData"><input asp-for="Tagline" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="Address" /></div>
            <div class="adminData"><input asp-for="Address" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="Phone1" /></div>
            <div class="adminData"><input asp-for="Phone1" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="Phone2" /></div>
            <div class="adminData"><input asp-for="Phone2" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="ZaloPhone" /></div>
            <div class="adminData"><input asp-for="ZaloPhone" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="FacebookUrl" /></div>
            <div class="adminData"><input asp-for="FacebookUrl" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="Email" /></div>
            <div class="adminData"><input asp-for="Email" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="MapUrl" /></div>
            <div class="adminData"><input asp-for="MapUrl" /></div>
        </div>

        <div class="adminRow">
            <div class="admin-config-group"><div class="title">@T("Plugins.Split3D.Studio.Group.Printing")</div></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="PrintPriceTable" /></div>
            <div class="adminData">
                <textarea asp-for="PrintPriceTable" rows="16" class="form-control text-monospace" spellcheck="false"></textarea>
                <span asp-validation-for="PrintPriceTable"></span>
                @if (Model.ParsedPrices.Count > 0)
                {
                    <div class="d-flex flex-wrap mt-2 small">
                        @foreach (var tech in Model.ParsedPrices)
                        {
                            foreach (var material in tech.Materials)
                            {
                                <div class="mr-4 mb-2">
                                    <div class="font-weight-bold">@tech.Name · @material.Name <span class="text-muted font-weight-normal">· @material.Density.ToString("0.##", CultureInfo.InvariantCulture) g/cm³</span></div>
                                    @foreach (var tier in material.Tiers)
                                    {
                                        <div>@tier.Label: <strong>@PrintPriceList.FormatPrice(tier.PricePerGram)/g</strong></div>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="PrintPriceNote" /></div>
            <div class="adminData"><input asp-for="PrintPriceNote" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="FdmWeightFactor" /></div>
            <div class="adminData"><input asp-for="FdmWeightFactor" sm-postfix="%" /><span asp-validation-for="FdmWeightFactor"></span></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="ResinWeightFactor" /></div>
            <div class="adminData"><input asp-for="ResinWeightFactor" sm-postfix="%" /><span asp-validation-for="ResinWeightFactor"></span></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="QuoteNotifyEmail" /></div>
            <div class="adminData"><input asp-for="QuoteNotifyEmail" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="QuoteMaxFileSizeMb" /></div>
            <div class="adminData"><input asp-for="QuoteMaxFileSizeMb" /><span asp-validation-for="QuoteMaxFileSizeMb"></span></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="QuoteMessageTemplate" /></div>
            <div class="adminData"><textarea asp-for="QuoteMessageTemplate" rows="4"></textarea></div>
        </div>

        <div class="adminRow">
            <div class="admin-config-group">
                <div class="title">@T("Plugins.Split3D.Studio.PrintOrders")</div>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="DepositPercent" /></div>
            <div class="adminData"><input asp-for="DepositPercent" sm-postfix="%" /><span asp-validation-for="DepositPercent"></span></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="AllowPickup" /></div>
            <div class="adminData"><input asp-for="AllowPickup" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="DepositNote" /></div>
            <div class="adminData"><textarea asp-for="DepositNote" rows="2"></textarea></div>
        </div>

        <div class="adminRow">
            <div class="admin-config-group">
                <div class="title">@T("Plugins.Split3D.Studio.Nameplate")</div>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="NameplateMinLength" /></div>
            <div class="adminData"><input asp-for="NameplateMinLength" sm-postfix="cm" /><span asp-validation-for="NameplateMinLength"></span></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="NameplateMaxLength" /></div>
            <div class="adminData"><input asp-for="NameplateMaxLength" sm-postfix="cm" /><span asp-validation-for="NameplateMaxLength"></span></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="NameplateBaseLength" /></div>
            <div class="adminData"><input asp-for="NameplateBaseLength" sm-postfix="cm" /><span asp-validation-for="NameplateBaseLength"></span></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="NameplatePercentPerCm" /></div>
            <div class="adminData"><input asp-for="NameplatePercentPerCm" sm-postfix="%" /><span asp-validation-for="NameplatePercentPerCm"></span></div>
        </div>

        <div class="adminRow">
            <div class="admin-config-group">
                <div class="title">@T("Plugins.Split3D.Studio.ClassBoard")</div>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="ClassBoardMinLength" /></div>
            <div class="adminData"><input asp-for="ClassBoardMinLength" sm-postfix="cm" /><span asp-validation-for="ClassBoardMinLength"></span></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="ClassBoardMaxLength" /></div>
            <div class="adminData"><input asp-for="ClassBoardMaxLength" sm-postfix="cm" /><span asp-validation-for="ClassBoardMaxLength"></span></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="ClassBoardBaseLength" /></div>
            <div class="adminData"><input asp-for="ClassBoardBaseLength" sm-postfix="cm" /><span asp-validation-for="ClassBoardBaseLength"></span></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="ClassBoardPercentPerCm" /></div>
            <div class="adminData"><input asp-for="ClassBoardPercentPerCm" sm-postfix="%" /><span asp-validation-for="ClassBoardPercentPerCm"></span></div>
        </div>

        <div class="adminRow">
            <div class="admin-config-group">
                <div class="title">@T("Plugins.Split3D.Studio.Qr")</div>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="QrMinLength" /></div>
            <div class="adminData"><input asp-for="QrMinLength" sm-postfix="cm" /><span asp-validation-for="QrMinLength"></span></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="QrMaxLength" /></div>
            <div class="adminData"><input asp-for="QrMaxLength" sm-postfix="cm" /><span asp-validation-for="QrMaxLength"></span></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="QrBaseLength" /></div>
            <div class="adminData"><input asp-for="QrBaseLength" sm-postfix="cm" /><span asp-validation-for="QrBaseLength"></span></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="QrPercentPerCm" /></div>
            <div class="adminData"><input asp-for="QrPercentPerCm" sm-postfix="%" /><span asp-validation-for="QrPercentPerCm"></span></div>
        </div>
    </div>
</form>
