@model PrintQuoteListModel

@{
    ViewBag.Title = T("Plugins.Split3D.Studio.Quotes").Value;
    Assets.BodyAttributes.AppendCssClass("spa-layout");
}

<div class="section-header">
    <div class="title">
        <i class="bi bi-printer"></i>
        @T("Plugins.Split3D.Studio.Quotes")
    </div>
    <div class="options">
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fa fa-plus"></i>
            <span>@T("Plugins.Split3D.PrintQuote.CreatePrint")</span>
        </a>
        <a href="@Url.Action("Create", new { design = true })" class="btn btn-primary">
            <i class="fa fa-plus"></i>
            <span>@T("Plugins.Split3D.PrintQuote.CreateDesign")</span>
        </a>
        <a href="@Url.RouteUrl(StudioStorefrontSetup.PrintServiceRouteName)" target="_blank" class="btn btn-secondary">
            <i class="bi bi-box-arrow-up-right"></i>
            <span>@T("Plugins.Split3D.PrintQuote.OpenPage")</span>
        </a>
        <a href="@Url.Action("List", "PrintJob")" class="btn btn-secondary">
            <i class="bi bi-box-seam"></i>
            <span>@T("Plugins.Split3D.PrintJob.ListTitle")</span>
        </a>
        <a href="@Url.Action("Settings")" class="btn btn-secondary">
            <i class="bi bi-gear"></i>
            <span>@T("Plugins.Split3D.Studio.Settings")</span>
        </a>
    </div>
</div>

<div class="px-3 pt-3">
    <div class="row mb-3">
        <div class="col-6 col-lg-3 mb-2">
            <div class="card card-body py-2">
                <div class="text-muted small text-uppercase">@T("Plugins.Split3D.PrintQuote.NewCount")</div>
                <div class="fs-h3 font-weight-bold text-danger">@Model.NewCount.ToString("N0")</div>
            </div>
        </div>
        <div class="col-6 col-lg-3 mb-2">
            <div class="card card-body py-2">
                <div class="text-muted small text-uppercase">@T("Plugins.Split3D.PrintQuote.OpenCount")</div>
                <div class="fs-h3 font-weight-bold text-primary">@Model.OpenCount.ToString("N0")</div>
            </div>
        </div>
        <div class="col-6 col-lg-3 mb-2">
            <div class="card card-body py-2">
                <div class="text-muted small text-uppercase">@T("Plugins.Split3D.PrintQuote.DueCount")</div>
                <div class="fs-h3 font-weight-bold text-warning">@Model.DueCount.ToString("N0")</div>
            </div>
        </div>
    </div>
</div>

@{ ViewBag.SearchModel = Model; }
<partial name="_Grid.PrintQuotes" model="null" />
