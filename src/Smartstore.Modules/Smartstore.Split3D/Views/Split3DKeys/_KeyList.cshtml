@model List<MyKeyModel>

@{
    var remainingDeactivations = ViewBag.RemainingDeactivations as int?;
}

@foreach (var key in Model)
{
    <div class="border rounded p-3 mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
            <div>
                <span class="font-weight-bold">@key.AddonName</span>
                <span class="text-muted ml-1">· @key.Plan</span>
                @if (key.IsBlocked)
                {
                    <span class="badge badge-dark ml-2">@T("Plugins.Split3D.State.Blocked")</span>
                }
                else if (key.IsLifetime)
                {
                    <span class="badge badge-success ml-2">@T("Plugins.Split3D.State.Lifetime")</span>
                }
                else if (key.IsExpired)
                {
                    <span class="badge badge-danger ml-2">@T("Plugins.Split3D.State.Expired")</span>
                }
                else
                {
                    <span class="badge badge-success ml-2">@T("Plugins.Split3D.State.Active")</span>
                }
            </div>
            <div class="text-muted small">
                @T("Plugins.Split3D.License.IssuedOn"): @key.IssuedOn
                @if (!key.IsLifetime)
                {
                    <span class="ml-2">· @T("Plugins.Split3D.License.ExpiresOn"): @key.ExpiresOn</span>
                }
                @if (key.Remaining != null)
                {
                    <span class="ml-2">· @T("Plugins.Split3D.MyKeys.Remaining", key.Remaining)</span>
                }
            </div>
        </div>
        <div class="s3d-key">@key.Token</div>
        <button type="button" class="btn btn-secondary btn-sm mt-2 split3d-copy" data-token="@key.Token">
            <i class="far fa-copy"></i>
            <span>@T("Plugins.Split3D.CopyKey")</span>
        </button>

        <div class="mt-3">
            <div class="font-weight-medium mb-1">
                <i class="bi bi-pc-display mr-1"></i>
                @T("Plugins.Split3D.MyKeys.Devices", key.Devices.Count, key.MaxDevices)
            </div>
            @if (key.Devices.Count == 0)
            {
                <div class="text-muted small">@T("Plugins.Split3D.MyKeys.NoDevices")</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-1">
                        <thead>
                            <tr class="small text-muted">
                                <th>@T("Plugins.Split3D.Device.DeviceName")</th>
                                <th>@T("Plugins.Split3D.Device.ActivatedOn")</th>
                                <th>@T("Plugins.Split3D.Device.ActiveFor")</th>
                                <th>@T("Plugins.Split3D.Device.LastSeenOn")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var device in key.Devices)
                            {
                                <tr>
                                    <td>
                                        <div class="font-weight-medium">@device.DeviceName</div>
                                        <div class="small text-muted">@device.Platform @(device.BlenderVersion.HasValue() ? "· Blender " + device.BlenderVersion : "")</div>
                                    </td>
                                    <td class="small">@device.ActivatedOn</td>
                                    <td class="small">@device.ActiveFor</td>
                                    <td class="small">@device.LastSeenOn</td>
                                    <td class="text-right">
                                        <form asp-action="DeactivateDevice" asp-controller="Split3DKeys" asp-route-id="@device.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger btn-sm split3d-deactivate"
                                                    data-confirm="@T("Plugins.Split3D.Device.DeactivateConfirm", device.DeviceName)"
                                                    disabled="@(remainingDeactivations == 0)">
                                                <i class="bi bi-box-arrow-right"></i>
                                                <span>@T("Plugins.Split3D.Device.Deactivate")</span>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
