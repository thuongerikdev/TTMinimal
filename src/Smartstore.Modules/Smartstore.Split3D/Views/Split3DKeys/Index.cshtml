@model MyKeysModel

@{
    Assets.AppendTitleParts(T("Plugins.Split3D.MyKeys"));

    Layout = "_MyAccount";
    ViewBag.PageClassToken = "split3d-keys";
    ViewBag.PageTitle = T("Plugins.Split3D.MyKeys").Value;
    ViewBag.RemainingDeactivations = Model.RemainingDeactivations;

    string StateBadge(Split3DOrderState state) => state switch
    {
        Split3DOrderState.AwaitingPayment => "badge-warning",
        Split3DOrderState.AwaitingKey => "badge-info",
        Split3DOrderState.Issued => "badge-success",
        _ => "badge-secondary"
    };

    int StepIndex(Split3DOrderState state) => state switch
    {
        Split3DOrderState.AwaitingPayment => 1,
        Split3DOrderState.AwaitingKey => 2,
        Split3DOrderState.Issued => 3,
        _ => 0
    };
}

<style>
    .s3d-steps { display: flex; gap: .5rem; margin: 1rem 0 1.25rem; }
    .s3d-steps .s3d-step { flex: 1; text-align: center; font-size: .85rem; color: #94a3b8; position: relative; padding-top: 2.1rem; }
    .s3d-steps .s3d-step:before { content: attr(data-n); position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 1.8rem; height: 1.8rem; line-height: 1.8rem; border-radius: 50%; background: #e2e8f0; color: #64748b; font-weight: 700; }
    .s3d-steps .s3d-step.done { color: #16a34a; }
    .s3d-steps .s3d-step.done:before { content: "✓"; background: #16a34a; color: #fff; }
    .s3d-steps .s3d-step.current { color: #0f172a; font-weight: 600; }
    .s3d-steps .s3d-step.current:before { background: #2563eb; color: #fff; }
    .s3d-key { font-family: SFMono-Regular, Consolas, monospace; font-size: .8rem; word-break: break-all; background: #f1f5f9; border-radius: .5rem; padding: .75rem; max-height: 7.5rem; overflow: auto; }
</style>

@if (Model.Orders.Count == 0 && Model.OtherKeys.Count == 0)
{
    <div class="alert alert-info">
        @T("Plugins.Split3D.MyKeys.Empty")
        <a href="@Url.Content("~/")" class="alert-link">@T("Plugins.Split3D.MyKeys.GoShopping")</a>
    </div>
    return;
}

@foreach (var order in Model.Orders)
{
    var step = StepIndex(order.State);

    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between">
            <div>
                <span class="font-weight-bold">@T("Plugins.Split3D.MyKeys.Order") #@order.OrderNumber</span>
                <span class="text-muted ml-2">@order.CreatedOn.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <span class="badge @StateBadge(order.State) px-3 py-2">@T("Plugins.Split3D.OrderState." + order.State)</span>
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between">
                <div>
                    @foreach (var item in order.Items)
                    {
                        <div>@item</div>
                    }
                </div>
                <div class="font-weight-bold">@order.OrderTotal</div>
            </div>

            @if (order.State != Split3DOrderState.Cancelled)
            {
                <div class="s3d-steps">
                    <div class="s3d-step done" data-n="1">@T("Plugins.Split3D.MyKeys.Step.Ordered")</div>
                    <div class="s3d-step @(step > 1 ? "done" : "current")" data-n="2">@T("Plugins.Split3D.MyKeys.Step.Paid")</div>
                    <div class="s3d-step @(step > 2 ? "done" : step == 2 ? "current" : "")" data-n="3">@T("Plugins.Split3D.MyKeys.Step.KeyIssued")</div>
                </div>
            }

            @switch (order.State)
            {
                case Split3DOrderState.AwaitingPayment:
                    <div class="alert alert-warning mb-0">
                        <div class="font-weight-bold mb-1">@T("Plugins.Split3D.MyKeys.PayHint")</div>
                        @if (Model.BankAccountNumber.HasValue())
                        {
                            <ul class="mb-0 pl-3">
                                <li>@T("Plugins.Split3D.MyKeys.Amount"): <strong>@order.OrderTotal</strong></li>
                                <li>@T("Plugins.Split3D.Fields.BankName"): <strong>@Model.BankName</strong></li>
                                <li>@T("Plugins.Split3D.Fields.BankAccountNumber"): <strong>@Model.BankAccountNumber</strong></li>
                                <li>@T("Plugins.Split3D.Fields.BankAccountHolder"): <strong>@Model.BankAccountHolder</strong></li>
                                <li>@T("Plugins.Split3D.MyKeys.TransferContent"): <strong>@order.OrderNumber</strong></li>
                            </ul>
                        }
                    </div>
                    break;
                case Split3DOrderState.AwaitingKey:
                    <div class="alert alert-info mb-0">@T("Plugins.Split3D.MyKeys.AwaitingKeyHint")</div>
                    break;
                case Split3DOrderState.Cancelled:
                    <div class="alert alert-secondary mb-0">@T("Plugins.Split3D.MyKeys.CancelledHint")</div>
                    break;
            }

            @if (order.Keys.Count > 0)
            {
                <partial name="_KeyList" model="order.Keys" />
                <a class="btn btn-primary mt-2" href="@Url.Action("DownloadableProducts", "Customer", new { area = "" })">
                    <i class="fa fa-download"></i>
                    <span>@T("Plugins.Split3D.MyKeys.DownloadAddon")</span>
                </a>
            }

            <a class="btn btn-link mt-2" href="@Url.Action("Details", "Order", new { id = order.OrderId, area = "" })">@T("Plugins.Split3D.MyKeys.OrderDetails")</a>
        </div>
    </div>
}

@if (Model.OtherKeys.Count > 0)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header font-weight-bold">@T("Plugins.Split3D.MyKeys.OtherKeys")</div>
        <div class="card-body">
            <partial name="_KeyList" model="Model.OtherKeys" />
        </div>
    </div>
}

<div class="text-muted small">@T("Plugins.Split3D.MyKeys.ActivateHint")</div>
<div class="text-muted small mt-1">
    @T("Plugins.Split3D.MyKeys.DevicesHint")
    @if (Model.RemainingDeactivations.HasValue)
    {
        <span>@T("Plugins.Split3D.MyKeys.RemainingDeactivations", Model.RemainingDeactivations.Value, Split3DDeviceService.CustomerLimitPeriodDays)</span>
    }
</div>

<script sm-target-zone="scripts" data-origin="split3d-mykeys">
    $(function () {
        $(document).on('click', '.split3d-copy', function (e) {
            e.preventDefault();
            var token = $(this).attr('data-token');
            navigator.clipboard.writeText(token).then(function () {
                displayNotification('@T("Plugins.Split3D.KeyCopied")', 'success');
            });
        });

        $(document).on('click', '.split3d-deactivate', function (e) {
            if (!confirm($(this).attr('data-confirm'))) {
                e.preventDefault();
            }
        });
    });
</script>
