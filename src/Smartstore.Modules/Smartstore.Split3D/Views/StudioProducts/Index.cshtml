@model StudioProductListModel

@{
    ViewBag.Title = "Sản phẩm";
    var visibleGroups = Model.Groups.Where(x => x.Products.Count > 0).ToList();
}

<div class="ttp" data-tt-products data-toggle-url="@Url.Action("SetPublished", "StudioProducts")" data-price-url="@Url.Action("SetPrice", "StudioProducts")">
    <div class="section-header">
        <div class="title">
            <i class="bi bi-box-seam"></i>
            Sản phẩm
        </div>
        <div class="options">
            <a href="@Url.Action("Create", "Product")" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i>
                <span>Thêm sản phẩm</span>
            </a>
            <div class="dropdown d-inline-block">
                <button type="button" class="btn btn-secondary dropdown-toggle" data-toggle="dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-three-dots"></i>
                    <span class="d-none d-md-inline">Thêm</span>
                </button>
                <div class="dropdown-menu dropdown-menu-right dropdown-menu-end">
                    <a class="dropdown-item" href="@Url.Action("List", "Category")"><i class="bi bi-folder2 mr-2 me-2"></i>Quản lý danh mục</a>
                    <a class="dropdown-item" href="@Url.Action("List", "Product", new { full = 1 })"><i class="bi bi-table mr-2 me-2"></i>Bảng đầy đủ (lọc nâng cao)</a>
                    <a class="dropdown-item" href="@Url.Action("RecycleBin", "Product")"><i class="bi bi-trash3 mr-2 me-2"></i>Sản phẩm đã xóa</a>
                </div>
            </div>
        </div>
    </div>

    <div class="ttp-body">
        <div class="ttp-toolbar">
            <label class="ttp-search">
                <i class="bi bi-search"></i>
                <input type="search" data-ttp-search placeholder="Tìm theo tên hoặc mã SKU…" autocomplete="off" aria-label="Tìm sản phẩm" />
                <kbd class="d-none d-md-inline">/</kbd>
            </label>

            <div class="ttp-filters" role="tablist" aria-label="Lọc sản phẩm">
                <button type="button" class="ttp-filter active" data-ttp-filter="all">
                    <span>Tất cả</span><b>@Model.TotalCount</b>
                </button>
                <button type="button" class="ttp-filter" data-ttp-filter="published">
                    <i class="ttp-dot ttp-dot-on"></i><span>Đang bán</span><b data-ttp-count="published">@Model.PublishedCount</b>
                </button>
                <button type="button" class="ttp-filter" data-ttp-filter="hidden">
                    <i class="ttp-dot"></i><span>Đang ẩn</span><b data-ttp-count="hidden">@Model.HiddenCount</b>
                </button>
                <button type="button" class="ttp-filter ttp-filter-warn" data-ttp-filter="attention" @(Model.AttentionCount == 0 ? "disabled" : null)>
                    <i class="bi bi-exclamation-triangle"></i><span>Cần xử lý</span><b data-ttp-count="attention">@Model.AttentionCount</b>
                </button>
            </div>
        </div>

        <div class="ttp-layout">
            <nav class="ttp-nav" aria-label="Nhóm sản phẩm">
                <div class="ttp-nav-title">Nhóm sản phẩm</div>
                @foreach (var group in visibleGroups)
                {
                    <a href="#g-@group.Key" class="ttp-nav-link tone-@group.Tone" data-ttp-nav="@group.Key">
                        <i class="@group.Icon"></i>
                        <span class="ttp-nav-text">
                            @if (group.Eyebrow.HasValue())
                            {
                                <small>@group.Eyebrow</small>
                            }
                            <span>@group.Title</span>
                        </span>
                        <b data-ttp-nav-count>@group.Products.Count</b>
                    </a>
                }
            </nav>

            <div class="ttp-groups">
                @foreach (var group in visibleGroups)
                {
                    <section class="ttp-group tone-@group.Tone @(group.Collapsed ? "collapsed" : null)" id="g-@group.Key" data-ttp-group="@group.Key">
                        <header class="ttp-group-head">
                            <button type="button" class="ttp-group-toggle" data-ttp-toggle aria-expanded="@(group.Collapsed ? "false" : "true")" aria-controls="rows-@group.Key">
                                <span class="ttp-group-icon"><i class="@group.Icon"></i></span>
                                <span class="ttp-group-title">
                                    @if (group.Eyebrow.HasValue())
                                    {
                                        <small>@group.Eyebrow</small>
                                    }
                                    <span class="h3">@group.Title <b class="ttp-count" data-ttp-group-count>@group.Products.Count</b></span>
                                </span>
                                <i class="bi bi-chevron-down ttp-chevron"></i>
                            </button>
                            @if (group.Links.Count > 0)
                            {
                                <div class="ttp-group-links">
                                    @foreach (var link in group.Links)
                                    {
                                        <a href="@link.Url" class="btn btn-sm btn-light" @(link.External ? Html.Raw("target=\"_blank\" rel=\"noopener\"") : null)>
                                            <i class="@link.Icon"></i>
                                            <span>@link.Text</span>
                                        </a>
                                    }
                                </div>
                            }
                        </header>

                        <div class="ttp-group-body" id="rows-@group.Key">
                            @if (group.Description.HasValue())
                            {
                                <p class="ttp-group-desc"><i class="bi bi-info-circle"></i> @group.Description</p>
                            }

                            <div class="ttp-row ttp-row-head" aria-hidden="true">
                                <span></span>
                                <span>Sản phẩm</span>
                                <span class="text-right text-end">Giá bán</span>
                                <span>Kho</span>
                                <span>Trên web</span>
                                <span></span>
                            </div>

                            @foreach (var p in group.Products)
                            {
                                var state = p.IsSystem ? "system" : p.Published ? "published" : "hidden";
                                <article class="ttp-row @(p.Published ? null : "is-hidden")" data-ttp-row data-search="@p.SearchText" data-state="@state" data-attention="@(p.Warnings.Count > 0 ? "1" : "0")">
                                    <a href="@p.EditUrl" class="ttp-thumb" tabindex="-1" aria-hidden="true">
                                        @if (p.ThumbUrl.HasValue())
                                        {
                                            <img src="@p.ThumbUrl" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-image"></i>
                                        }
                                    </a>

                                    <div class="ttp-main">
                                        <a href="@p.EditUrl" class="ttp-name">@p.Name</a>
                                        <div class="ttp-meta">
                                            @if (p.Sku.HasValue())
                                            {
                                                <span class="ttp-sku" title="Mã SKU">@p.Sku</span>
                                            }
                                            <span>Sửa lần cuối @p.UpdatedText</span>
                                        </div>
                                        @if (p.Warnings.Count > 0 || p.Badges.Count > 0)
                                        {
                                            <div class="ttp-badges">
                                                @foreach (var warning in p.Warnings)
                                                {
                                                    <span class="ttp-badge ttp-badge-warn" @(warning == "Chưa có giá" ? "data-ttp-warn-price" : null)><i class="bi bi-exclamation-triangle-fill"></i> @warning</span>
                                                }
                                                @foreach (var badge in p.Badges)
                                                {
                                                    <span class="ttp-badge">@badge</span>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="ttp-price">
                                        @if (Model.CanEdit && p.PriceEditable)
                                        {
                                            <button type="button" class="ttp-price-edit" data-ttp-price="@p.Id" data-value="@p.Price.ToString("0", System.Globalization.CultureInfo.InvariantCulture)" title="Bấm để sửa giá">
                                                <span data-ttp-price-text>@p.PriceText</span>
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            @p.PriceText
                                        }
                                    </div>

                                    <div class="ttp-stock stock-@p.StockTone">@p.StockText</div>

                                    <div class="ttp-status">
                                        @if (p.IsSystem)
                                        {
                                            <span class="ttp-auto"><i class="bi bi-gear"></i> Tự động</span>
                                        }
                                        else if (Model.CanEdit)
                                        {
                                            <label class="ttp-switch" title="Bật = khách thấy và mua được trên web">
                                                <input type="checkbox" data-ttp-publish="@p.Id" @(p.Published ? "checked" : null) />
                                                <span class="ttp-switch-track"></span>
                                                <span class="ttp-switch-text" data-on="Đang bán" data-off="Đang ẩn">@(p.Published ? "Đang bán" : "Đang ẩn")</span>
                                            </label>
                                        }
                                        else
                                        {
                                            <span class="ttp-switch-text">@(p.Published ? "Đang bán" : "Đang ẩn")</span>
                                        }
                                    </div>

                                    <div class="ttp-actions">
                                        <a href="@p.EditUrl" class="btn btn-sm btn-secondary">
                                            <i class="bi bi-pencil"></i>
                                            <span>Sửa</span>
                                        </a>
                                        @if (p.ShopUrl.HasValue() && !p.IsSystem)
                                        {
                                            <a href="@p.ShopUrl" class="btn btn-sm btn-light btn-icon" target="_blank" rel="noopener" title="Xem trên web">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                            </a>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }

                <div class="ttp-empty" data-ttp-empty hidden>
                    <i class="bi bi-search"></i>
                    <p>Không tìm thấy sản phẩm nào.</p>
                    <button type="button" class="btn btn-secondary btn-sm" data-ttp-reset>Xem tất cả</button>
                </div>

                @if (visibleGroups.Count == 0)
                {
                    <div class="ttp-empty">
                        <i class="bi bi-box-seam"></i>
                        <p>Chưa có sản phẩm nào.</p>
                        <a href="@Url.Action("Create", "Product")" class="btn btn-primary btn-sm">Thêm sản phẩm đầu tiên</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="ttp-toast" data-ttp-toast role="status" aria-live="polite"></div>
</div>
