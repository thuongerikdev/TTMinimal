@model ToolsPageModel

@{
    // Module views default to the admin layout (Views/_ViewStart.cshtml); this is a storefront page.
    Layout = "_Layout";
    Assets.AppendTitleParts("Công cụ 3D – addon Blender cho người làm in 3D");
    Assets.AppendMetaDescriptionParts("Công cụ 3D (addon Blender) cho người làm in 3D: chọn gói theo thời hạn và số máy, mua ngay, nhận key và bản cập nhật tự động.");
    Assets.BodyAttributes.AppendCssClass("tt-studio-page");
}

<div class="tt">
    <section class="tt-bleed tt-page-hero tt-page-hero--mint tt-page-hero--compact">
        <div class="tt-wrap">
            <div class="tt-tag tt-tilt" data-tt-reveal>CÔNG CỤ 3D · ADDON BLENDER</div>
            <h1 class="tt-split">LÀM 3D NHANH HƠN.<br /><em>IN 3D DỄ HƠN.</em></h1>
            <p data-tt-reveal style="--d:.25s">
                Chọn gói theo thời hạn và số máy, bấm <b>Mua ngay</b> — key và link tải gửi tự động ngay khi thanh toán xong.
                Bản cập nhật tải thẳng trong Blender.
            </p>
        </div>
    </section>

    <section class="tt-bleed tt-section tt-section--tools">
        <div class="tt-wrap">
            @if (Model.Tools.Count == 0)
            {
                <p class="tt-lead">Công cụ đang được cập nhật, bạn quay lại sau nhé.</p>
            }

            <partial name="_StudioTools" model="Model" />
        </div>
    </section>
</div>
