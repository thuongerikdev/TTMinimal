@model Smartstore.Split3D.Configuration.Split3DSettings

<div class="alert alert-info my-4">
    <div class="h5 mb-2">@T("Plugins.Split3D.Completed.Title")</div>
    <ol class="mb-3 pl-3">
        <li>
            @T("Plugins.Split3D.Completed.Step1")
            @if (Model.BankAccountNumber.HasValue())
            {
                <ul class="mt-1">
                    <li>@T("Plugins.Split3D.Fields.BankName"): <strong>@Model.BankName</strong></li>
                    <li>@T("Plugins.Split3D.Fields.BankAccountNumber"): <strong>@Model.BankAccountNumber</strong></li>
                    <li>@T("Plugins.Split3D.Fields.BankAccountHolder"): <strong>@Model.BankAccountHolder</strong></li>
                    <li>@T("Plugins.Split3D.MyKeys.TransferContent"): <strong>@T("Plugins.Split3D.Completed.OrderNumber")</strong></li>
                </ul>
            }
        </li>
        <li>@T("Plugins.Split3D.Completed.Step2")</li>
        <li>@T("Plugins.Split3D.Completed.Step3")</li>
    </ol>
    <a class="btn btn-primary" href="@Url.Action("Index", "Split3DKeys", new { area = "" })">
        <i class="fa fa-key"></i>
        <span>@T("Plugins.Split3D.MyKeys.Track")</span>
    </a>
</div>
