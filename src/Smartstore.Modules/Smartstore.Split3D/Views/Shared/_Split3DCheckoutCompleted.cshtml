@model CheckoutCompletedModel

@{
    var settings = Model.Settings;
}

<div class="alert alert-info my-4">
    <div class="h5 mb-2">@(Model.PrintOnly ? T("Plugins.Split3D.Completed.PrintTitle") : T("Plugins.Split3D.Completed.Title"))</div>
    @if (Model.PrintJobCodes.Count > 0)
    {
        <p class="mb-2">
            @T("Plugins.Split3D.Completed.PrintJob", string.Join(", ", Model.PrintJobCodes))
            @if (Model.Outstanding > 0)
            {
                <text> </text>@T("Plugins.Split3D.Completed.PrintOutstanding", PrintPriceList.FormatPrice(Model.Outstanding))
            }
        </p>
    }
    @if (Model.IsPaid)
    {
        <p class="mb-3">@T("Plugins.Split3D.Completed.PaidOnline")</p>
    }
    else if (Model.CanPayOnline)
    {
        <ol class="mb-3 pl-3">
            <li>
                @T("Plugins.Split3D.Completed.Step1Online")
                <form method="post" asp-controller="Order" asp-action="Details" asp-route-id="@Model.OrderId" asp-area="" class="mt-2">
                    <button type="submit" name="repost-payment" value="repost-payment" class="btn btn-success">
                        <i class="fa fa-qrcode"></i>
                        <span>@T("Plugins.Split3D.MyKeys.PayOnline")</span>
                    </button>
                </form>
            </li>
            <li>@(Model.PrintOnly ? T("Plugins.Split3D.Completed.PrintStep2") : T("Plugins.Split3D.Completed.Step2Online"))</li>
            <li>@(Model.PrintOnly ? T("Plugins.Split3D.Completed.PrintStep3") : T("Plugins.Split3D.Completed.Step3"))</li>
        </ol>
    }
    else
    {
        <ol class="mb-3 pl-3">
            <li>
                @T("Plugins.Split3D.Completed.Step1")
                @if (Model.IsBankTransfer && settings.BankAccountNumber.HasValue())
                {
                    <ul class="mt-1">
                        <li>@T("Plugins.Split3D.Fields.BankName"): <strong>@settings.BankName</strong></li>
                        <li>@T("Plugins.Split3D.Fields.BankAccountNumber"): <strong>@settings.BankAccountNumber</strong></li>
                        <li>@T("Plugins.Split3D.Fields.BankAccountHolder"): <strong>@settings.BankAccountHolder</strong></li>
                        <li>@T("Plugins.Split3D.MyKeys.TransferContent"): <strong>@T("Plugins.Split3D.Completed.OrderNumber")</strong></li>
                    </ul>
                    @if (Model.BankQrSvg.HasValue())
                    {
                        <div class="mt-2" style="max-width: 220px">
                            <div class="bg-white rounded p-1">@Html.Raw(Model.BankQrSvg)</div>
                            <div class="small text-muted mt-1">@T("Plugins.Split3D.BankQr.Hint")</div>
                        </div>
                    }
                }
            </li>
            <li>@(Model.PrintOnly ? T("Plugins.Split3D.Completed.PrintStep2") : T("Plugins.Split3D.Completed.Step2"))</li>
            <li>@(Model.PrintOnly ? T("Plugins.Split3D.Completed.PrintStep3") : T("Plugins.Split3D.Completed.Step3"))</li>
        </ol>
    }
    @if (Model.PrintOnly)
    {
        <a class="btn btn-primary" href="@Url.Action("Details", "Order", new { id = Model.OrderId, area = "" })">
            <i class="fa fa-receipt"></i>
            <span>@T("Plugins.Split3D.Completed.PrintTrack")</span>
        </a>
    }
    else
    {
        <a class="btn btn-primary" href="@Url.Action("Index", "Split3DKeys", new { area = "" })">
            <i class="fa fa-key"></i>
            <span>@T("Plugins.Split3D.MyKeys.Track")</span>
        </a>
    }
</div>
