@model List<PrintTechnology>
@inject Smartstore.Split3D.Configuration.StudioSettings StudioSettings

@{
    var quoteUrl = (string)ViewData["QuoteUrl"];
    var json = System.Text.Json.JsonSerializer.Serialize(Model.Select(x => new
    {
        name = x.Name,
        resin = x.IsResin,
        // Calibration of the weight estimated from an uploaded model (1 = as computed).
        factor = Math.Max(10, x.IsResin ? StudioSettings.ResinWeightFactor : StudioSettings.FdmWeightFactor) / 100d,
        mats = x.Materials.Select(m => new
        {
            name = m.Name,
            density = m.Density,
            tiers = m.Tiers.Select(t => new { min = t.MinGrams, price = t.PricePerGram, label = t.Label })
        })
    }));
    string Delay(int i) => (i * 0.08).ToString("0.00", CultureInfo.InvariantCulture) + "s";
}

@* Price configurator. Inputs are text fields on purpose: Smartstore wraps every input[type=number] into its own stepper widget. *@
<div class="tt-config" data-tt-config="@json" data-tt-mesh-src="@Url.Content(StudioAssets.MeshScript)">
    <div class="tt-techs" role="group" aria-label="Kiểu in và loại nhựa">
        @for (var i = 0; i < Model.Count; i++)
        {
            var tech = Model[i];
            <div class="tt-tech@(i == 0 ? " is-active" : "")" data-tech="@i" data-tt-reveal style="--d:@Delay(i);--n:@Math.Max(tech.Materials.Count, 1)">
                <button type="button" class="tt-tech-head" data-mat="0">
                    <span class="tt-tech-name">@tech.Name</span>
                    <small>@tech.Materials.Count loại @(tech.IsResin ? "resin" : "nhựa")</small>
                </button>
                @for (var j = 0; j < tech.Materials.Count; j++)
                {
                    var mat = tech.Materials[j];
                    <button type="button" class="tt-tech-mat@(i == 0 && j == 0 ? " is-active" : "")" data-mat="@j" aria-pressed="@(i == 0 && j == 0 ? "true" : "false")">
                        <span>@mat.Name</span>
                        <b>@PrintPriceList.FormatPrice(mat.LowestPrice)</b>
                        <small>/gram trở lên</small>
                    </button>
                }
                <div class="tt-tech-desc">@tech.Description</div>
            </div>
        }

        @* Drop zone and 3D preview of the dropped model, under the technology cards. *@
        <div class="tt-meter-dropwrap">
            <label class="tt-meter-drop" data-tt-drop>
                <input type="file" accept=".stl,.obj,.3mf" multiple data-tt-file aria-label="Chọn một hoặc nhiều file 3D để tự cân" />
                <span class="tt-meter-sticker" aria-hidden="true">Miễn phí<br />5 giây</span>
                <span class="tt-meter-icon">@StudioIcons.Get("upload")</span>
                <span class="tt-meter-text">
                    <b>Thả file 3D vào đây để tính giá</b>
                    <small>STL · OBJ · 3MF, thả nhiều file cùng lúc để tính tổng — tự đo kích thước X·Y·Z, xem mô hình 3D và tính số gram theo loại nhựa. File chỉ đọc trên máy bạn, chưa gửi đi.</small>
                </span>
                <span class="tt-meter-pick">Chọn file từ máy</span>
            </label>
            <p class="tt-meter-error" data-tt-meter-error hidden></p>
        </div>

        <div class="tt-viewer" data-tt-viewer hidden>
            <div class="tt-viewer-head">
                <span class="tt-viewer-tag">Xem trước 3D</span>
                <b data-tt-vname></b>
                <button type="button" class="tt-viewer-max" data-tt-vmax aria-pressed="false">@StudioIcons.Get("expand")<span>Phóng to</span></button>
            </div>
            <div class="tt-viewer-stage">
                <canvas data-tt-view aria-label="Mô hình 3D, kéo để xoay, chuột phải hoặc Shift kéo để di chuyển, cuộn để phóng to"></canvas>
                <span class="tt-viewer-size" data-tt-vsize></span>
            </div>
            <div class="tt-viewer-foot">
                <span>Kéo để xoay · chuột phải / Shift + kéo để di chuyển · cuộn để phóng to</span>
                <button type="button" class="tt-textlink" data-tt-vreset>Góc nhìn ban đầu</button>
            </div>
        </div>
    </div>

    <div class="tt-panel" data-tt-reveal="right">
        <div class="tt-panel-head">
            <h3>Bậc giá · <span data-tt-techname>@Model.FirstOrDefault()?.Name @Model.FirstOrDefault()?.Materials.FirstOrDefault()?.Name</span></h3>
            <span>đơn giá / gram theo tổng khối lượng</span>
        </div>

        <div class="tt-chart" data-tt-chart aria-hidden="true"></div>
        <div class="tt-bar-labels" data-tt-labels aria-hidden="true"></div>

        <div class="tt-meter" data-tt-meter>
            @* Dropped models: a collapsible list (tick = counted in the total, own quantity and price) and a total tab. *@
            <div class="tt-models" data-tt-models hidden>
                <div class="tt-models-head">
                    <button type="button" class="tt-models-toggle" data-tt-mtoggle aria-expanded="true" aria-controls="tt-models-body">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                        <b data-tt-msum></b>
                    </button>
                    <button type="button" class="tt-textlink" data-tt-change>+ Thêm file</button>
                </div>
                <div class="tt-models-body" id="tt-models-body" data-tt-mbody>
                    <div class="tt-models-tabs" role="tablist" aria-label="Danh sách mô hình">
                        <button type="button" role="tab" aria-selected="true" data-tt-mtab="list">Từng file</button>
                        <button type="button" role="tab" aria-selected="false" data-tt-mtab="sum">Tổng</button>
                        <label class="tt-model-check tt-models-all"><input type="checkbox" data-tt-mall checked /><span aria-hidden="true"></span>Tính tất cả</label>
                    </div>
                    <ol class="tt-models-list" role="tabpanel" data-tt-mlist></ol>
                    <div class="tt-models-total" role="tabpanel" data-tt-mtotal hidden></div>
                </div>
            </div>
            <div class="tt-meter-body" data-tt-meter-body hidden>
                <div class="tt-meter-info">
                    <div class="tt-meter-file">
                        <b data-tt-fname></b>
                    </div>
                    <div class="tt-dims">
                        <label><span>X</span><input type="text" inputmode="decimal" autocomplete="off" data-axis="0" aria-label="Kích thước X (mm)" /></label>
                        <label><span>Y</span><input type="text" inputmode="decimal" autocomplete="off" data-axis="1" aria-label="Kích thước Y (mm)" /></label>
                        <label><span>Z</span><input type="text" inputmode="decimal" autocomplete="off" data-axis="2" aria-label="Kích thước Z (mm)" /></label>
                        <em>mm</em>
                    </div>
                    <div class="tt-meter-opts">
                        <label class="tt-check tt-check--sm"><input type="checkbox" data-tt-lock checked /><span>Giữ tỉ lệ</span></label>
                        <label class="tt-select">
                            <span>Đơn vị file</span>
                            <select class="noskin" data-tt-unitsel>
                                <option value="1">mm</option>
                                <option value="10">cm</option>
                                <option value="25.4">inch</option>
                                <option value="1000">m</option>
                            </select>
                        </label>
                        <label class="tt-select">
                            <span data-tt-filllabel>Độ đặc</span>
                            <select class="noskin" data-tt-fill></select>
                        </label>
                    </div>
                    <div class="tt-meter-stats" data-tt-stats></div>
                </div>
            </div>
        </div>

        <div class="tt-fields">
            <div class="tt-num">
                <label for="tt-grams">Khối lượng 1 mẫu <span class="tt-auto" data-tt-auto hidden>tự cân</span></label>
                <div class="tt-num-box">
                    <button type="button" data-step="-1" data-target="#tt-grams" aria-label="Giảm">−</button>
                    <input id="tt-grams" type="text" inputmode="numeric" autocomplete="off" value="120" data-tt-grams />
                    <em>g</em>
                    <button type="button" data-step="1" data-target="#tt-grams" aria-label="Tăng">+</button>
                </div>
            </div>
            <div class="tt-num">
                <label for="tt-qty">Số lượng</label>
                <div class="tt-num-box">
                    <button type="button" data-step="-1" data-target="#tt-qty" aria-label="Giảm">−</button>
                    <input id="tt-qty" type="text" inputmode="numeric" autocomplete="off" value="1" data-tt-qty />
                    <em>cái</em>
                    <button type="button" data-step="1" data-target="#tt-qty" aria-label="Tăng">+</button>
                </div>
            </div>
        </div>
        <input class="tt-range" type="range" min="0" max="100" step="0.5" aria-label="Kéo để chọn khối lượng" data-tt-range />

        <div class="tt-total">
            <div>
                <small>Tạm tính</small>
                <strong data-tt-total>—</strong>
                <em data-tt-unit></em>
            </div>
            <a class="tt-button tt-button--dark" href="@quoteUrl" data-base="@quoteUrl" data-tt-cta>
                <span>Gửi file báo giá</span>
                @StudioIcons.Get("arrow", "tt-arrow")
            </a>
        </div>

        @if (ViewData["PriceNote"] is string note && note.HasValue())
        {
            <p class="tt-note-line">@StudioIcons.Get("spark")<span>@note Khối lượng tự cân là ước tính, chưa gồm support; studio sẽ chốt theo file slice thực tế.</span></p>
        }
    </div>
</div>
