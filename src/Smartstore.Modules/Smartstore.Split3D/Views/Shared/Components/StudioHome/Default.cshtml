@model StudioHomeModel

@{
    var contact = Model.Contact;
    var techs = Model.Technologies;
    var fdm = techs.FirstOrDefault(x => x.Name.Contains("FDM", StringComparison.OrdinalIgnoreCase));
    var resinPrices = techs.Where(x => x.Name.Contains("Resin", StringComparison.OrdinalIgnoreCase)).Select(x => x.LowestPrice).ToList();
    var lowest = techs.Count > 0 ? techs.Min(x => x.LowestPrice) : 0;
    var phone = contact.Phone1.NullEmpty() ?? contact.Phone2;
    var split3D = Model.Addons.FirstOrDefault(x => x.Name.Contains("Split3D", StringComparison.OrdinalIgnoreCase));
    var collage = Model.Products.Where(x => x.ImageUrl.HasValue()).Select(x => x.ImageUrl)
        .Concat(Model.Categories.Where(x => x.ImageUrl.HasValue()).Select(x => x.ImageUrl))
        .Take(3).ToList();
    var miniJson = System.Text.Json.JsonSerializer.Serialize(techs.Select(x => new
    {
        name = x.Name,
        tiers = x.Tiers.Select(t => new { min = t.MinGrams, price = t.PricePerGram, label = t.Label })
    }));
    var rowA = new[] { "In 3D theo yêu cầu", "FDM", "Resin", "Thiết kế 3D", "Render", "Addon Blender" };
    var rowB = new[] { "PLA", "PETG", "ABS", "Resin Standard", "Resin Like ABS", "Chỉnh sửa file", "Hà Nội" };
    string Delay(int i, double step = .08) => (i * step).ToString("0.00", CultureInfo.InvariantCulture) + "s";

    ViewData["QuoteUrl"] = Model.PrintServiceUrl;
    ViewData["PriceNote"] = Model.PrintPriceNote;
}

<div class="tt">

    @* ================= HERO ================= *@
    <section class="tt-bleed tt-hero">
        <div class="tt-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="tt-grid-bg" aria-hidden="true"></div>

        <div class="tt-wrap tt-hero-inner">
            <div>
                <div class="tt-kicker"><b>TT Minimal</b> · Minimal 3D Printing Studio · Hà Nội</div>
                <h1 class="tt-hero-title tt-split">
                    <span>Biến ý tưởng</span>
                    <span>thành <span class="tt-rotator"><span>mô hình</span><span>figure</span><span>linh kiện</span><span>quà tặng</span><span>nguyên mẫu</span></span></span>
                    <span class="tt-outline">in 3D thật.</span>
                </h1>
                <p class="tt-hero-lead" data-tt-reveal style="--d:.35s">
                    Studio in 3D <b>FDM &amp; Resin</b> theo yêu cầu, tự thiết kế <b>sản phẩm in 3D</b>
                    và phát triển <b>addon Blender</b> cho người làm 3D.
                </p>
                <div class="tt-actions" data-tt-reveal style="--d:.5s">
                    <a class="tt-btn" href="@Model.PrintServiceUrl#tt-quote" data-magnetic>
                        @StudioIcons.Get("upload")
                        <span>Gửi file báo giá</span>
                    </a>
                    <a class="tt-btn tt-btn--ghost" href="#tt-pricing" data-magnetic>
                        <span>Xem bảng giá</span>
                        @StudioIcons.Get("arrow", "tt-arrow")
                    </a>
                </div>
            </div>

            <div class="tt-stage" data-tt-reveal="zoom" style="--d:.2s">
                <canvas id="tt-hero-canvas" role="img" aria-label="Mô hình 3D đang được in từng lớp"></canvas>
                <div class="tt-stage-frame" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
                <div class="tt-hud tt-hud--tl" aria-hidden="true">Đang in<br /><b data-hud-file>VASE_01.STL</b></div>
                <div class="tt-hud tt-hud--tr" aria-hidden="true">Layer<br /><b data-hud-layer>01 / 46</b></div>
                <div class="tt-hud tt-hud--bl" aria-hidden="true">
                    Tiến độ <b data-hud-pct>0%</b>
                    <div class="tt-hud-bar"><i data-hud-bar></i></div>
                </div>
            </div>
        </div>

        <div class="tt-hero-foot">
            <div class="tt-wrap">
                @if (fdm != null)
                {
                    <div class="tt-stat"><strong>@PrintPriceList.FormatPrice(fdm.LowestPrice)/g</strong><span>In FDM chỉ từ</span></div>
                }
                @if (resinPrices.Count > 0)
                {
                    <div class="tt-stat"><strong>@PrintPriceList.FormatPrice(resinPrices.Min())/g</strong><span>In Resin chỉ từ</span></div>
                }
                <div class="tt-stat"><strong>@techs.Count công nghệ</strong><span>@string.Join(" · ", techs.Select(x => x.Name))</span></div>
                <div class="tt-stat"><strong>3 in 1</strong><span>Thiết kế · Sửa file · Render</span></div>
            </div>
        </div>
    </section>

    @* ================= MARQUEE ================= *@
    <div class="tt-bleed tt-marquee" aria-hidden="true">
        <div class="tt-marquee-row">
            @for (var n = 0; n < 2; n++) { foreach (var w in rowA) { <span>@w</span> } }
        </div>
        <div class="tt-marquee-row">
            @for (var n = 0; n < 2; n++) { foreach (var w in rowB) { <span>@w</span> } }
        </div>
    </div>

    @* ================= SERVICES (BENTO) ================= *@
    <section id="tt-services" class="tt-bleed tt-section">
        <div class="tt-wrap">
            <div class="tt-head">
                <div>
                    <div class="tt-kicker">01 — Dịch vụ</div>
                    <h2 class="tt-h2 tt-split">Một studio, <span class="tt-grad">ba cách</span> đưa 3D vào đời thật</h2>
                </div>
                <p class="tt-lead" data-tt-reveal>Có file cần in, cần một món đồ in 3D đẹp, hay cần công cụ để tự làm — chúng tôi đều có thể giúp.</p>
            </div>

            <div class="tt-bento">
                <div class="tt-card tt-b-print" data-tt-reveal>
                    <span class="tt-tag">@StudioIcons.Get("printer") In 3D theo yêu cầu</span>
                    <h3>Gửi file, nhận báo giá<br />theo từng gram</h3>
                    <p>FDM cho mô hình lớn &amp; linh kiện bền; Resin cho figure, chi tiết sắc nét. In càng nhiều, đơn giá càng giảm.</p>
                    @if (lowest > 0)
                    {
                        <div class="tt-b-big">@PrintPriceList.FormatPrice(lowest)<small> /gram trở lên</small></div>
                    }
                    @if (techs.Count > 0)
                    {
                        <div class="tt-mini" data-tt-mini="@miniJson">
                            <div class="tt-chips">
                                @for (var i = 0; i < techs.Count; i++)
                                {
                                    <button type="button" class="tt-chip@(i == 0 ? " is-active" : "")" data-tech="@i">@techs[i].Name</button>
                                }
                            </div>
                            <div class="tt-mini-row">
                                <input class="tt-range" type="range" min="0" max="100" step="0.5" value="45" aria-label="Khối lượng mẫu in" data-tt-range />
                                <div class="tt-mini-out"><strong data-tt-total>—</strong><span data-tt-unit></span></div>
                            </div>
                        </div>
                    }
                    <div class="tt-b-foot">
                        <a class="tt-btn tt-btn--sm" href="@Model.PrintServiceUrl#tt-quote">@StudioIcons.Get("upload") <span>Gửi file</span></a>
                        <a class="tt-link" href="@Model.PrintServiceUrl">Chi tiết dịch vụ @StudioIcons.Get("arrow", "tt-arrow")</a>
                    </div>
                </div>

                <a class="tt-card tt-b-shop" href="#tt-products" data-tt-reveal style="--d:.1s">
                    <span class="tt-tag">@StudioIcons.Get("bag") Cửa hàng</span>
                    <h3>Sản phẩm TT Minimal</h3>
                    <p>Thiết kế độc quyền của studio, nhiều màu sắc và kích cỡ, hoàn thiện kỹ trước khi giao.</p>
                    <div class="tt-collage">
                        @for (var i = 0; i < 3; i++)
                        {
                            <span>
                                @if (i < collage.Count)
                                {
                                    <img src="@collage[i]" alt="" loading="lazy" onerror="this.remove()" />
                                }
                                else
                                {
                                    @StudioIcons.Get(i == 0 ? "cube" : i == 1 ? "layers" : "spark")
                                }
                            </span>
                        }
                    </div>
                </a>

                <a class="tt-card tt-b-addon" href="#tt-addons" data-tt-reveal style="--d:.2s">
                    <span class="tt-tag">@StudioIcons.Get("puzzle") Addon Blender</span>
                    <h3>Công cụ chuẩn bị file in</h3>
                    <div class="tt-term" data-tt-term='["$ split3d cut model.stl --bed 256","[ok] Chia 6 mảnh vừa bàn in","[ok] Tạo chốt nối, chỉnh dung sai","[ok] Xuất file sẵn sàng để in"]'>$ split3d cut model.stl</div>
                </a>

                <div class="tt-card tt-b-sm" data-tt-reveal>
                    <span class="tt-ico">@StudioIcons.Get("pencil")</span>
                    <h3>Thiết kế 3D</h3>
                    <p>Nhân vật, đồ vật, bối cảnh — từ ảnh, bản vẽ hay chỉ một ý tưởng.</p>
                </div>
                <div class="tt-card tt-b-sm" data-tt-reveal style="--d:.1s">
                    <span class="tt-ico">@StudioIcons.Get("wrench")</span>
                    <h3>Chỉnh sửa file</h3>
                    <p>Sửa lỗi lưới, chia mảnh, thêm khớp nối cho file bạn cung cấp.</p>
                </div>
                <div class="tt-card tt-b-sm" data-tt-reveal style="--d:.2s">
                    <span class="tt-ico">@StudioIcons.Get("image")</span>
                    <h3>Render hình ảnh</h3>
                    <p>Ảnh render đẹp để duyệt mẫu trước khi in hoặc giới thiệu sản phẩm.</p>
                </div>
            </div>
        </div>
    </section>

    @* ================= PROCESS (PINNED) ================= *@
    <section id="tt-process" class="tt-bleed tt-process">
        <div class="tt-process-pin">
            <div class="tt-process-head">
                <div class="tt-kicker">02 — Quy trình</div>
                <h2 class="tt-h2 tt-split">Từ file đến tay bạn trong <span class="tt-grad">4 bước</span></h2>
            </div>
            <div class="tt-process-track">
                <div class="tt-card tt-step">
                    <span class="tt-step-num">01</span><span class="tt-ico">@StudioIcons.Get("upload")</span>
                    <h3>Gửi file</h3>
                    <p>Tải file STL, OBJ, 3MF, STEP… lên trang báo giá, hoặc gửi qua Zalo, Facebook. Chưa có file? Gửi ảnh hoặc mô tả.</p>
                </div>
                <div class="tt-card tt-step">
                    <span class="tt-step-num">02</span><span class="tt-ico">@StudioIcons.Get("calc")</span>
                    <h3>Nhận báo giá</h3>
                    <p>Chúng tôi kiểm tra file, tư vấn công nghệ và vật liệu phù hợp, báo giá theo khối lượng in thực tế.</p>
                </div>
                <div class="tt-card tt-step">
                    <span class="tt-step-num">03</span><span class="tt-ico">@StudioIcons.Get("layers")</span>
                    <h3>In &amp; hoàn thiện</h3>
                    <p>In từng lớp, gỡ support, xử lý phôi và ghép phôi theo yêu cầu của bạn.</p>
                </div>
                <div class="tt-card tt-step">
                    <span class="tt-step-num">04</span><span class="tt-ico">@StudioIcons.Get("truck")</span>
                    <h3>Nhận hàng</h3>
                    <p>Nhận tại xưởng ở Hà Nội hoặc giao tận nơi trên toàn quốc.</p>
                </div>
            </div>
            <div class="tt-process-bar" aria-hidden="true"><i></i></div>
        </div>
    </section>

    @* ================= PRICING ================= *@
    @if (techs.Count > 0)
    {
        <section id="tt-pricing" class="tt-bleed tt-section">
            <div class="tt-wrap">
                <div class="tt-head">
                    <div>
                        <div class="tt-kicker">03 — Bảng giá</div>
                        <h2 class="tt-h2 tt-split">Minh bạch đến <span class="tt-grad">từng gram</span></h2>
                    </div>
                    <p class="tt-lead" data-tt-reveal>Chọn công nghệ, nhập khối lượng và số lượng để xem giá tạm tính ngay. Bậc giá áp dụng theo tổng khối lượng đơn in.</p>
                </div>
                <partial name="_StudioPriceCalc" model="techs" />
            </div>
        </section>
    }

    @* ================= SHOP ================= *@
    <section id="tt-products" class="tt-bleed tt-section" style="padding-top:0">
        <div class="tt-wrap">
            <div class="tt-head">
                <div>
                    <div class="tt-kicker">04 — Cửa hàng</div>
                    <h2 class="tt-h2 tt-split">Sản phẩm do <span class="tt-grad">@contact.BrandName</span> thiết kế</h2>
                </div>
                <p class="tt-lead" data-tt-reveal>Mỗi sản phẩm có nhiều lựa chọn màu sắc và kích cỡ. In theo đơn, kiểm tra kỹ trước khi giao.</p>
            </div>

            @if (Model.Products.Count > 0)
            {
                @if (Model.Categories.Count > 1)
                {
                    <div class="tt-chips tt-filter" data-tt-filter="#tt-product-grid" data-tt-reveal>
                        <button type="button" class="tt-chip is-active" data-cat="all">Tất cả</button>
                        @foreach (var cat in Model.Categories)
                        {
                            <button type="button" class="tt-chip" data-cat="@cat.Id">@cat.Name</button>
                        }
                    </div>
                }
                <div class="tt-products" id="tt-product-grid">
                    @for (var i = 0; i < Model.Products.Count; i++)
                    {
                        var p = Model.Products[i];
                        <a class="tt-card tt-product" href="@p.Url" data-cat="@p.CategoryId" data-tt-reveal style="--d:@Delay(i % 4)">
                            <div class="tt-product-media">
                                @if (p.ImageUrl.HasValue())
                                {
                                    <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" onerror="this.remove()" />
                                }
                                else
                                {
                                    <span class="tt-noimg">@StudioIcons.Get("cube")</span>
                                }
                                @if (p.HasVariants)
                                {
                                    <span class="tt-badge">Nhiều màu &amp; size</span>
                                }
                                <span class="tt-go">@StudioIcons.Get("arrow")</span>
                            </div>
                            <div class="tt-product-body">
                                @if (p.CategoryName.HasValue())
                                {
                                    <span class="tt-product-cat">@p.CategoryName</span>
                                }
                                <span class="tt-product-name">@p.Name</span>
                                <span class="tt-product-price">
                                    @(p.PriceFrom ? "Từ " : "")@p.Price
                                    @if (p.OldPrice.HasValue())
                                    {
                                        <del>@p.OldPrice</del>
                                    }
                                </span>
                            </div>
                        </a>
                    }
                </div>
                @if (Model.Categories.Count > 0)
                {
                    <div class="tt-actions" style="margin-top:2.5rem" data-tt-reveal>
                        @foreach (var cat in Model.Categories.Take(3))
                        {
                            <a class="tt-btn tt-btn--ghost tt-btn--sm" href="@cat.Url"><span>@cat.Name</span> @StudioIcons.Get("arrow", "tt-arrow")</a>
                        }
                    </div>
                }
            }
            else
            {
                <div class="tt-card tt-soon" data-tt-reveal>
                    <div>
                        <span class="tt-tag">@StudioIcons.Get("spark") Sắp ra mắt</span>
                        <h3>Bộ sưu tập đầu tiên đang được hoàn thiện</h3>
                        <p>Những sản phẩm đầu tiên của studio sắp lên kệ. Theo dõi fanpage để không bỏ lỡ — hoặc đặt in theo ý bạn ngay hôm nay.</p>
                        <div class="tt-actions">
                            @if (contact.FacebookUrl.HasValue())
                            {
                                <a class="tt-btn tt-btn--sm" href="@contact.FacebookUrl" target="_blank" rel="noopener">@StudioIcons.Get("facebook") <span>Theo dõi fanpage</span></a>
                            }
                            <a class="tt-btn tt-btn--ghost tt-btn--sm" href="@Model.PrintServiceUrl"><span>Đặt in theo yêu cầu</span> @StudioIcons.Get("arrow", "tt-arrow")</a>
                        </div>
                    </div>
                    <div class="tt-ghosts" aria-hidden="true">
                        <div class="tt-ghost"><b></b><i></i><i></i></div>
                        <div class="tt-ghost" style="--d:.3s"><b></b><i></i><i></i></div>
                        <div class="tt-ghost" style="--d:.6s"><b></b><i></i><i></i></div>
                    </div>
                </div>
            }
        </div>
    </section>

    @* ================= ADDONS ================= *@
    @if (Model.Addons.Count > 0)
    {
        <section id="tt-addons" class="tt-bleed tt-section" style="padding-top:0">
            <div class="tt-wrap tt-addon-grid">
                <div>
                    <div class="tt-kicker">05 — Addon Blender</div>
                    <h2 class="tt-h2 tt-split">Công cụ của studio, <span class="tt-grad">giờ là của bạn</span></h2>
                    <p class="tt-lead" style="margin-top:1.2rem" data-tt-reveal>Chúng tôi viết addon Blender để chuẩn bị file in nhanh hơn. Mua một lần, nhận key tự động qua email và cập nhật ngay trong Blender.</p>
                    <div class="tt-addon-list">
                        @for (var i = 0; i < Model.Addons.Count; i++)
                        {
                            var addon = Model.Addons[i];
                            <a class="tt-card tt-addon" href="@addon.Url" data-tt-reveal style="--d:@Delay(i, .1)">
                                @if (addon.ImageUrl.HasValue())
                                {
                                    <img src="@addon.ImageUrl" alt="@addon.Name" loading="lazy" onerror="this.remove()" />
                                }
                                else
                                {
                                    <span class="tt-addon-ph">@StudioIcons.Get("puzzle")</span>
                                }
                                <div>
                                    <h3>@addon.Name @if (addon.Version.HasValue()) { <small>v@(addon.Version)</small> }</h3>
                                    <p>@addon.Description</p>
                                </div>
                                <div class="tt-addon-price">Từ @addon.PriceFrom<small>@addon.PlanCount gói thời hạn</small></div>
                            </a>
                        }
                    </div>
                    @if (Model.AddonCategoryUrl.HasValue())
                    {
                        <a class="tt-btn tt-btn--ghost" href="@Model.AddonCategoryUrl" data-tt-reveal data-magnetic><span>Tất cả addon &amp; bảng giá</span> @StudioIcons.Get("arrow", "tt-arrow")</a>
                    }
                </div>

                <div data-tt-reveal="right">
                    <div class="tt-window" aria-hidden="true">
                        <div class="tt-window-bar"><i></i><i></i><i></i><span>Blender — @(split3D?.Name ?? Model.Addons[0].Name)</span></div>
                        <div class="tt-window-body">
                            <div class="tt-viewport">
                                <svg viewBox="0 0 400 300" fill="none" stroke-linejoin="round">
                                    <defs>
                                        <linearGradient id="ttg" x1="0" x2="1" y1="0" y2="1"><stop offset="0" stop-color="#3ee0ff" /><stop offset=".5" stop-color="#2f6bff" /><stop offset="1" stop-color="#8b5cff" /></linearGradient>
                                    </defs>
                                    <g stroke="rgba(130,150,255,.12)">
                                        <path d="M40 250 L200 290 L360 250 L200 210 Z" />
                                        <path d="M80 240 L200 270 L320 240" /><path d="M120 230 L200 250 L280 230" />
                                    </g>
                                    <g class="tt-part-top" stroke="url(#ttg)" stroke-width="1.6" fill="rgba(47,107,255,.10)">
                                        <path d="M200 50 L290 95 L200 140 L110 95 Z" />
                                        <path d="M110 95 L110 140 L200 185 L200 140 Z" fill="rgba(47,107,255,.06)" />
                                        <path d="M290 95 L290 140 L200 185 L200 140 Z" fill="rgba(139,92,255,.08)" />
                                    </g>
                                    <g stroke="url(#ttg)" stroke-width="1.6" fill="rgba(47,107,255,.14)">
                                        <path d="M110 150 L200 195 L290 150 L290 200 L200 245 L110 200 Z" />
                                        <path d="M200 195 L200 245" />
                                        <circle cx="160" cy="176" r="6" fill="#3ee0ff" stroke="none" />
                                        <circle cx="240" cy="176" r="6" fill="#3ee0ff" stroke="none" />
                                    </g>
                                    <g class="tt-cut">
                                        <path d="M70 146 L330 146" stroke="#3ee0ff" stroke-width="1.5" stroke-dasharray="6 6" />
                                        <text x="334" y="150" fill="#3ee0ff" font-size="11" font-family="monospace">CUT</text>
                                    </g>
                                </svg>
                            </div>
                            <div class="tt-sidepanel">
                                <h5>@(split3D?.Name ?? "Addon")</h5>
                                <div class="tt-opt">Cắt vòng 360° <span class="tt-toggle"></span></div>
                                <div class="tt-opt">Khớp nối <em>Chốt tròn</em></div>
                                <div class="tt-opt">Dung sai <em>Tùy chỉnh</em></div>
                                <div class="tt-opt">Kiểm tra bàn in <span class="tt-toggle"></span></div>
                                <div class="tt-opt">Ngôn ngữ <em>VI / EN</em></div>
                                <div class="tt-fake-btn">Cắt &amp; tạo khớp</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    @* ================= WHY ================= *@
    <section class="tt-bleed tt-section" style="padding-top:0">
        <div class="tt-wrap">
            <div class="tt-head">
                <div>
                    <div class="tt-kicker">06 — Vì sao chọn chúng tôi</div>
                    <h2 class="tt-h2 tt-split">Làm việc với studio, <span class="tt-grad">không phải cỗ máy</span></h2>
                </div>
            </div>
            <div class="tt-why">
                <div class="tt-card" data-tt-reveal><span class="tt-ico">@StudioIcons.Get("calc")</span><b>Bảng giá công khai</b><p>Đơn giá theo gram cho từng công nghệ, tự tính trước chi phí trước khi liên hệ.</p></div>
                <div class="tt-card" data-tt-reveal style="--d:.08s"><span class="tt-ico">@StudioIcons.Get("chat")</span><b>Tư vấn theo file thật</b><p>Chúng tôi xem file của bạn để tư vấn vật liệu, cách in và cách hoàn thiện.</p></div>
                <div class="tt-card" data-tt-reveal style="--d:.16s"><span class="tt-ico">@StudioIcons.Get("pencil")</span><b>Từ ý tưởng đến file</b><p>Không có file 3D? Studio nhận thiết kế, sửa file và render hình ảnh.</p></div>
                <div class="tt-card" data-tt-reveal style="--d:.24s"><span class="tt-ico">@StudioIcons.Get("pin")</span><b>Xưởng tại Hà Nội</b><p>Nhận hàng trực tiếp tại xưởng hoặc giao tận nơi trên toàn quốc.</p></div>
            </div>
        </div>
    </section>

    @* ================= FAQ ================= *@
    <section class="tt-bleed tt-section" style="padding-top:0">
        <div class="tt-wrap tt-faq-grid">
            <div>
                <div class="tt-kicker">07 — Hỏi đáp</div>
                <h2 class="tt-h2 tt-split">Câu hỏi thường gặp</h2>
                <p class="tt-lead" style="margin:1.2rem 0 2rem" data-tt-reveal>Chưa thấy câu trả lời? Gọi hoặc nhắn Zalo cho chúng tôi.</p>
                @if (phone.HasValue())
                {
                    <a class="tt-btn tt-btn--ghost" href="@StudioContactModel.TelUrl(phone)" data-tt-reveal data-magnetic>@StudioIcons.Get("phone") <span>@StudioContactModel.FormatPhone(phone)</span></a>
                }
            </div>
            <div class="tt-faq" data-tt-reveal="right">
                <details open>
                    <summary>Tôi cần gửi file định dạng gì? <i></i></summary>
                    <div class="tt-faq-a"><p>STL, OBJ, 3MF, STEP… hoặc nén thành .zip. Chưa có file 3D thì gửi ảnh, bản vẽ hay mô tả — studio có dịch vụ thiết kế 3D.</p></div>
                </details>
                <details>
                    <summary>Giá in được tính như thế nào? <i></i></summary>
                    <div class="tt-faq-a"><p>Khối lượng in thực tế (gram) × đơn giá của công nghệ theo bậc tổng khối lượng: đơn càng nặng, đơn giá mỗi gram càng thấp. @Model.PrintPriceNote</p></div>
                </details>
                <details>
                    <summary>Nên chọn FDM hay Resin? <i></i></summary>
                    <div class="tt-faq-a"><p>FDM (PLA, PETG, ABS) bền, giá tốt, hợp mô hình lớn và linh kiện. Resin cho bề mặt mịn, chi tiết sắc nét, hợp figure và mô hình nhỏ. Chưa chắc? Cứ gửi file để được tư vấn.</p></div>
                </details>
                <details>
                    <summary>Tôi nhận hàng bằng cách nào? <i></i></summary>
                    <div class="tt-faq-a"><p>Nhận tại xưởng (@contact.Address) hoặc chọn giao hàng tận nơi khi đặt hàng.</p></div>
                </details>
                <details>
                    <summary>Mua addon Blender thì nhận key thế nào? <i></i></summary>
                    <div class="tt-faq-a"><p>Khi thanh toán được xác nhận, key được gửi qua email và hiện trong mục Key của tôi; file cài đặt tải trong tài khoản.</p></div>
                </details>
            </div>
        </div>
    </section>

    @* ================= CTA ================= *@
    <section class="tt-bleed tt-section" style="padding-top:0">
        <div class="tt-wrap">
            <div class="tt-cta" data-tt-reveal="zoom">
                <div class="tt-kicker">Bắt đầu dự án</div>
                <h2>Sẵn sàng <span class="tt-grad">in</span> chưa?</h2>
                <p>Gửi file để nhận báo giá, hoặc liên hệ trực tiếp để được tư vấn vật liệu và cách hoàn thiện.</p>
                <div class="tt-actions">
                    <a class="tt-btn tt-btn--light" href="@Model.PrintServiceUrl#tt-quote" data-magnetic>@StudioIcons.Get("upload") <span>Gửi file báo giá</span></a>
                    @if (contact.ZaloUrl.HasValue())
                    {
                        <a class="tt-btn tt-btn--ghost" href="@contact.ZaloUrl" target="_blank" rel="noopener" data-magnetic>@StudioIcons.Get("chat") <span>Nhắn Zalo</span></a>
                    }
                </div>
                <div class="tt-contacts">
                    @foreach (var p in contact.Phones)
                    {
                        <a href="@StudioContactModel.TelUrl(p)">@StudioIcons.Get("phone") @StudioContactModel.FormatPhone(p)</a>
                    }
                    @if (contact.FacebookUrl.HasValue())
                    {
                        <a href="@contact.FacebookUrl" target="_blank" rel="noopener">@StudioIcons.Get("facebook") Fanpage</a>
                    }
                    @if (contact.Address.HasValue())
                    {
                        <a href="@(contact.MapUrl ?? "#")" target="_blank" rel="noopener">@StudioIcons.Get("pin") @contact.Address</a>
                    }
                </div>
            </div>
        </div>
    </section>
</div>
