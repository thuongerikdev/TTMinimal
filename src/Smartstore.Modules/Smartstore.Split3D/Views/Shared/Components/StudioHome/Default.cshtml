@model StudioHomeModel

@{
    var contact = Model.Contact;
    var techs = Model.Technologies;
    var lowest = techs.Count > 0 ? techs.Min(x => x.LowestPrice) : 0;
    var phone = contact.Phone1.NullEmpty() ?? contact.Phone2;
    var tools = Model.Tools.Tools;
    var split3D = tools.FirstOrDefault(x => x.Name.Contains("Split3D", StringComparison.OrdinalIgnoreCase)) ?? tools.FirstOrDefault();
    var toys = Url.Content("~/Modules/Smartstore.Split3D/studio/studio-toys.webp");
    var toysCut = Url.Content("~/Modules/Smartstore.Split3D/studio/studio-toys-cut.webp");
    var cardColors = new[] { "mint", "yellow", "lilac", "pink" };
    var serviceCats = Model.ServiceCategories;
    string Delay(int i, double step = .08) => (i * step).ToString("0.00", CultureInfo.InvariantCulture) + "s";

    ViewData["QuoteUrl"] = Model.PrintServiceUrl;
    ViewData["PriceNote"] = Model.PrintPriceNote;
}

<div class="tt">

    @* ================= HERO ================= *@
    <section class="tt-bleed tt-hero">
        <div class="tt-wrap tt-hero-grid">
            <div class="tt-hero-copy">
                <div class="tt-tag tt-tilt" data-tt-reveal>XƯỞNG NHỎ. Ý TƯỞNG TO.</div>
                <h1 class="tt-split">Ý TƯỞNG<br />CỦA BẠN.<br /><em>IN THÀNH THẬT.</em></h1>
                <p data-tt-reveal style="--d:.25s">Từ một file 3D đến món đồ cầm trên tay.<br />Thêm chút sáng tạo. Thêm nhiều cá tính.</p>
                <div class="tt-actions" data-tt-reveal style="--d:.35s">
                    <a class="tt-button tt-button--dark" href="@Model.PrintServiceUrl#tt-quote">Gửi file báo giá</a>
                    <a class="tt-textlink" href="#tt-services">Khám phá studio</a>
                </div>
                @if (techs.Count > 0)
                {
                    <partial name="_StudioHeroDrop" />
                }
                <div class="tt-hero-foot" data-tt-reveal style="--d:.45s">FDM &amp; Resin <span>✦</span> Thiết kế &amp; hoàn thiện@(lowest > 0 ? " ✦ từ " + PrintPriceList.FormatPrice(lowest) + "/g" : "")</div>
            </div>

            @* 3D card: tilts with the pointer, toys, label and sticker sit at different depths. *@
            <div class="tt-art-stage" data-tt-reveal="zoom" style="--d:.15s">
                <div class="tt-art3d" data-tt-3d>
                    <div class="tt-art3d-card">
                        <img class="tt-art3d-toys" src="@toysCut" alt="Khủng long mint, robot hồng và bình vàng in 3D" width="900" height="900" />
                        <span class="tt-art3d-shine" aria-hidden="true"></span>
                    </div>
                    <div class="tt-art-label">CUTE THINGS, REAL THINGS.</div>
                    <div class="tt-art-sticker">ĐƯỢC LÀM<br />THEO Ý BẠN ♡</div>
                </div>
            </div>
        </div>
    </section>

    <div class="tt-bleed tt-ribbon" aria-hidden="true">
        <div class="tt-marquee-row">
            @for (var n = 0; n < 4; n++)
            {
                <span>PRINT YOUR IDEAS. <b>✦</b> MAKE IT YOURS. <b>✦</b> A LITTLE DIFFERENT. <b>✦</b> A LOT OF FUN. <b>✦</b></span>
            }
        </div>
    </div>

    @* ================= SERVICES ================= *@
    <section class="tt-wrap tt-section" id="tt-services">
        <div class="tt-section-heading">
            <div>
                <div class="tt-kicker">CHỌN MỘT ĐIỀU HAY HO</div>
                <h2 class="tt-split">BẠN CẦN GÌ <mark>HÔM NAY?</mark></h2>
            </div>
            <p data-tt-reveal>Một studio. Ba cách để sáng tạo.</p>
        </div>
        <div class="tt-cards">
            <article class="tt-cardpop tt-mint" data-tt-reveal data-tt-tilt="5">
                <div class="tt-card-top"><span class="tt-number">01</span><span class="tt-pill">FDM / RESIN</span></div>
                <h3>CÓ FILE?<br />CÓ ĐỒ THẬT.</h3>
                <p>In mô hình, figure, linh kiện và quà tặng theo yêu cầu của bạn@(lowest > 0 ? ", giá từ " + PrintPriceList.FormatPrice(lowest) + "/gram" : "").</p>
                <a class="tt-button" href="@Model.PrintServiceUrl">Khám phá dịch vụ in</a>
            </article>
            <article class="tt-cardpop tt-yellow" data-tt-reveal data-tt-tilt="5" style="--d:.08s">
                <div class="tt-card-top"><span class="tt-number">02</span><span class="tt-pill">MADE BY TT</span></div>
                <h3>ĐỒ NHỎ.<br />GU RẤT RIÊNG.</h3>
                <p>Những món đồ in 3D do studio thiết kế, dành cho góc nhỏ của bạn.</p>
                <a class="tt-button" href="#tt-products">Xem bộ sưu tập</a>
            </article>
            <article class="tt-cardpop tt-lilac" data-tt-reveal data-tt-tilt="5" style="--d:.16s">
                <div class="tt-card-top"><span class="tt-number">03</span><span class="tt-pill">BLENDER ADDON</span></div>
                <h3>ÍT THAO TÁC.<br />NHIỀU SÁNG TẠO.</h3>
                <p>Công cụ giúp chia mô hình và chuẩn bị file in ngay trong Blender.</p>
                <a class="tt-button" href="#tt-addons">Khám phá @(split3D?.Name ?? "Split3D")</a>
            </article>
        </div>
    </section>

    @* ================= PRICING ================= *@
    @if (techs.Count > 0)
    {
        <section class="tt-bleed tt-pricing" id="tt-pricing">
            <div class="tt-wrap">
                <div class="tt-section-heading">
                    <div>
                        <div class="tt-kicker">BẢNG GIÁ IN 3D</div>
                        <h2 class="tt-split">TÍNH GIÁ <mark>TRONG 5 GIÂY.</mark></h2>
                    </div>
                    <p data-tt-reveal>Chọn kiểu in, loại nhựa, thả file 3D để tự cân — hoặc nhập khối lượng. In càng nhiều, đơn giá mỗi gram càng giảm.</p>
                </div>
                <partial name="_StudioPriceCalc" model="techs" />
            </div>
        </section>
    }

    @* ================= COLLECTION ================= *@
    <section class="tt-bleed tt-collection" id="tt-products">
        @if (Model.Products.Count > 0)
        {
            <div class="tt-wrap tt-wrap--wide">
                <div class="tt-section-heading">
                    <div>
                        <div class="tt-kicker">BỘ SƯU TẬP CỦA STUDIO</div>
                        <h2 class="tt-split">NHỎ XINH.<br /><mark>CÁ TÍNH LỚN.</mark></h2>
                    </div>
                </div>
                <div class="tt-shelf@(serviceCats.Count > 0 ? "" : " tt-shelf--single")">
                    @if (serviceCats.Count > 0)
                    {
                        <nav class="tt-shelf-nav" data-tt-filter="#tt-product-grid" aria-label="Danh mục dịch vụ">
                            <div class="tt-shelf-title">Danh mục dịch vụ</div>
                            <button type="button" class="tt-shelf-item is-active" data-cat="all" data-url="">
                                <span>Tất cả</span><b>@Model.Products.Count</b>
                            </button>
                            @for (var i = 0; i < serviceCats.Count; i++)
                            {
                                var cat = serviceCats[i];
                                <button type="button" class="tt-shelf-item" data-cat="@cat.Id" data-url="@cat.Url" data-name="@cat.Name">
                                    <i class="tt-@(cardColors[i % cardColors.Length])"></i><span>@cat.Name</span><b>@cat.ProductCount</b>
                                </button>
                            }
                        </nav>
                    }
                    <div class="tt-shelf-main">
                        @* Two full rows at first, "Xem thêm" reveals the next two (studio.js initPaging). *@
                        <div class="tt-products" id="tt-product-grid" data-tt-page="@(serviceCats.Count > 0 ? 10 : 12)" data-tt-rows="2">
                            @for (var i = 0; i < Model.Products.Count; i++)
                            {
                                var p = Model.Products[i];
                                <a class="tt-product tt-@(cardColors[i % cardColors.Length])" href="@p.Url" data-cat="@string.Join(' ', p.CategoryIds)" data-tt-reveal style="--d:@Delay(i % 4)">
                                    <div class="tt-product-media">
                                        <span class="tt-noimg">✦</span>
                                        @if (p.ImageUrl.HasValue())
                                        {
                                            <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" onerror="this.remove()" />
                                        }
                                        @if (p.IsCustom)
                                        {
                                            <span class="tt-badge tt-badge--custom">✎ TUỲ CHỈNH</span>
                                        }
                                        else if (p.HasVariants)
                                        {
                                            <span class="tt-badge">NHIỀU MÀU &amp; SIZE</span>
                                        }
                                    </div>
                                    <span class="tt-product-cat">@(p.CategoryName ?? "MADE BY TT")</span>
                                    <span class="tt-product-name">@p.Name</span>
                                    <span class="tt-product-price">
                                        @(p.PriceFrom && !p.Price.StartsWith("Từ") ? "Từ " : "")@p.Price
                                        @if (p.OldPrice.HasValue())
                                        {
                                            <del>@p.OldPrice</del>
                                        }
                                    </span>
                                </a>
                            }
                        </div>
                        <div class="tt-actions tt-more-actions">
                            <button type="button" class="tt-button tt-button--ghost" data-tt-show-more hidden>
                                Xem thêm sản phẩm <small>(còn <span>0</span>)</small> ↓
                            </button>
                            @if (serviceCats.Count > 0)
                            {
                                var firstCat = serviceCats[0];
                                <a class="tt-button" href="@firstCat.Url" data-tt-filter-more hidden>
                                    Xem tất cả <span>@firstCat.Name</span> →
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="tt-wrap tt-collection-grid">
                <div class="tt-collection-art" data-tt-reveal data-tt-tilt="6">
                    <img src="@toys" alt="Phong cách sản phẩm của studio" width="900" height="900" loading="lazy" />
                    <span class="tt-tag">MỘT CHÚT CẢM HỨNG ✦</span>
                </div>
                <div>
                    <div class="tt-kicker">BỘ SƯU TẬP ĐẦU TIÊN</div>
                    <h2 class="tt-split">NHỎ XINH.<br /><mark>CÁ TÍNH LỚN.</mark></h2>
                    <p data-tt-reveal>Những thiết kế đầu tiên đang được hoàn thiện.<br />Trong lúc chờ, hãy cùng tạo một món đồ của riêng bạn.</p>
                    <div class="tt-actions" data-tt-reveal>
                        <a class="tt-button tt-button--dark" href="@Model.PrintServiceUrl#tt-quote">Đặt in theo ý bạn</a>
                        @if (contact.FacebookUrl.HasValue())
                        {
                            <a class="tt-textlink" href="@contact.FacebookUrl" target="_blank" rel="noopener">Theo dõi fanpage</a>
                        }
                    </div>
                    <div class="tt-micro">Hình minh họa ý tưởng · Bộ sưu tập sắp ra mắt</div>
                </div>
            </div>
        }
    </section>

    @* ================= TOOLS ================= *@
    @if (tools.Count > 0)
    {
        <section class="tt-wrap tt-section" id="tt-addons">
            <div class="tt-section-heading">
                <div>
                    <div class="tt-kicker">CÔNG CỤ TỪ CHÍNH STUDIO</div>
                    <h2 class="tt-split">MÔ HÌNH LỚN? <mark>CHUYỆN NHỎ.</mark></h2>
                </div>
                <p data-tt-reveal>Addon Blender giúp chia mô hình, tạo khớp và chuẩn bị file in. Bấm vào công cụ để xem tính năng và chọn gói.</p>
            </div>
            <partial name="_StudioTools" model="Model.Tools" />
        </section>
    }

    @* ================= PROCESS ================= *@
    <section class="tt-bleed tt-process-pop">
        <div class="tt-wrap">
            <div class="tt-kicker">KHÔNG CẦN PHỨC TẠP</div>
            <h2 class="tt-split">BẠN NGHĨ. <mark>CHÚNG TÔI IN.</mark></h2>
            <div class="tt-steps">
                <article data-tt-reveal><span>01</span><h3>Gửi ý tưởng</h3><p>File 3D, ảnh tham khảo hoặc một mô tả ngắn.</p></article>
                <article data-tt-reveal style="--d:.08s"><span>02</span><h3>Chốt phương án</h3><p>Tư vấn vật liệu, kiểm tra file và báo giá.</p></article>
                <article data-tt-reveal style="--d:.16s"><span>03</span><h3>In &amp; hoàn thiện</h3><p>Tạo hình và xử lý theo yêu cầu đã thống nhất.</p></article>
                <article data-tt-reveal style="--d:.24s"><span>04</span><h3>Nhận món đồ</h3><p>Nhận tại xưởng hoặc giao hàng toàn quốc.</p></article>
            </div>
        </div>
    </section>

    @* ================= FAQ ================= *@
    <section class="tt-wrap tt-section tt-faq-pop">
        <h2 class="tt-split">MỘT CHÚT <mark>HỎI ĐÁP.</mark></h2>
        <div class="tt-faq">
            <details open>
                <summary>Chưa có file 3D thì có đặt in được không? <i></i></summary>
                <div class="tt-faq-a"><p>Được. Bạn gửi ảnh, bản vẽ hoặc mô tả ý tưởng để studio tư vấn thiết kế và báo giá.</p></div>
            </details>
            <details>
                <summary>Nên chọn FDM hay Resin? <i></i></summary>
                <div class="tt-faq-a"><p>FDM phù hợp mô hình lớn, đồ gia dụng và chi tiết kỹ thuật. Resin phù hợp mô hình nhỏ, figure và những chi tiết cần độ sắc nét cao. Studio sẽ tư vấn dựa trên file thực tế.</p></div>
            </details>
            <details>
                <summary>Giá in được tính như thế nào? <i></i></summary>
                <div class="tt-faq-a"><p>Khối lượng in (gram) × đơn giá của công nghệ theo bậc tổng khối lượng. @Model.PrintPriceNote Gửi file để nhận báo giá cụ thể.</p></div>
            </details>
            <details>
                <summary>Tôi nhận hàng bằng cách nào? <i></i></summary>
                <div class="tt-faq-a"><p>Nhận tại xưởng (@contact.Address) hoặc chọn giao hàng tận nơi khi đặt hàng.</p></div>
            </details>
            <details>
                <summary>Mua addon Blender thì nhận key thế nào? <i></i></summary>
                <div class="tt-faq-a"><p>Khi thanh toán được xác nhận, key được gửi qua email và hiện trong mục Key của tôi; file cài đặt tải trong tài khoản.</p></div>
            </details>
        </div>
    </section>

    @* ================= CONTACT ================= *@
    <section class="tt-bleed tt-contact" id="tt-contact">
        <div class="tt-wrap">
            <span class="tt-tag tt-tilt" data-tt-reveal>Ý TƯỞNG NÀO CŨNG CÓ THỂ BẮT ĐẦU BẰNG MỘT TIN NHẮN</span>
            <h2 class="tt-split">LÀM MỘT ĐIỀU<br /><em>THẬT HAY HO.</em></h2>
            <div class="tt-actions" data-tt-reveal>
                @if (contact.ZaloUrl.HasValue())
                {
                    <a class="tt-button tt-button--dark" href="@contact.ZaloUrl" target="_blank" rel="noopener">Nhắn Zalo cho studio</a>
                }
                <a class="tt-button" href="@Model.PrintServiceUrl#tt-quote">Gửi file báo giá</a>
            </div>
            <div class="tt-contact-line" data-tt-reveal>
                @foreach (var p in contact.Phones)
                {
                    <a href="@StudioContactModel.TelUrl(p)">@StudioContactModel.FormatPhone(p)</a>
                }
                @if (contact.Address.HasValue())
                {
                    <a href="@(contact.MapUrl ?? "#")" target="_blank" rel="noopener">@contact.Address</a>
                }
            </div>
        </div>
    </section>
</div>
