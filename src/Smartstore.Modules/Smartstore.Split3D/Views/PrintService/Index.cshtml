@model PrintServicePageModel

@addTagHelper Smartstore.Web.TagHelpers.Public.*, Smartstore.Web.Common

@{
    // Module views default to the admin layout (Views/_ViewStart.cshtml); this is a storefront page.
    Layout = "_Layout";
    Assets.AppendTitleParts("In 3D theo yêu cầu – bảng giá & báo giá");
    Assets.AppendMetaDescriptionParts($"Dịch vụ in 3D FDM, Resin theo yêu cầu tại Hà Nội của {Model.Contact.BrandName}. Bảng giá theo gram, tính giá tạm và gửi file để nhận báo giá.");
    Assets.BodyAttributes.AppendCssClass("tt-studio-page");

    var contact = Model.Contact;
    var form = Model.Form;
    var selectedTech = form.Technology.NullEmpty() ?? Model.Technologies.FirstOrDefault()?.Name;
    var quoteUrl = Url.RouteUrl(StudioStorefrontSetup.PrintServiceRouteName);
    var lowest = Model.Technologies.Count > 0 ? Model.Technologies.Min(x => x.LowestPrice) : 0;
    ViewData["QuoteUrl"] = quoteUrl;
    ViewData["PriceNote"] = Model.PrintPriceNote;
    string Delay(int i) => (i * 0.1).ToString("0.0", CultureInfo.InvariantCulture) + "s";
}

<div class="tt">
    <section class="tt-bleed tt-page-hero">
        <div class="tt-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="tt-grid-bg" aria-hidden="true"></div>
        <div class="tt-wrap">
            <div class="tt-kicker"><b>Dịch vụ in 3D</b> · @contact.BrandName · Hà Nội</div>
            <h1 class="tt-hero-title tt-split">
                <span>In 3D theo yêu cầu,</span>
                <span><span class="tt-grad">FDM &amp; Resin</span></span>
            </h1>
            <p class="tt-hero-lead" data-tt-reveal style="--d:.3s">
                Gửi file 3D để nhận báo giá cụ thể@(lowest > 0 ? $" — giá chỉ từ {PrintPriceList.FormatPrice(lowest)}/gram" : "").
                Nhận thêm <b>thiết kế 3D</b> nhân vật, đồ vật, bối cảnh, <b>chỉnh sửa file</b> và <b>render</b> hình ảnh 3D.
            </p>
            <div class="tt-actions" data-tt-reveal style="--d:.45s">
                <a class="tt-btn" href="#tt-quote" data-magnetic>@StudioIcons.Get("upload") <span>Gửi file báo giá</span></a>
                <a class="tt-btn tt-btn--ghost" href="#tt-calc" data-magnetic><span>Tính giá tạm</span> @StudioIcons.Get("arrow", "tt-arrow")</a>
            </div>
        </div>
    </section>

    @if (Model.Technologies.Count > 0)
    {
        <section class="tt-bleed" style="padding-bottom:clamp(4rem,8vw,7rem)">
            <div class="tt-wrap">
                <div class="tt-tiers-grid">
                    @for (var i = 0; i < Model.Technologies.Count; i++)
                    {
                        var tech = Model.Technologies[i];
                        <div class="tt-card tt-tiercard" data-tt-reveal style="--d:@Delay(i)">
                            <span class="tt-mat">@tech.Materials</span>
                            <h3>@tech.Name</h3>
                            <p>@tech.Description</p>
                            <div class="tt-from">@PrintPriceList.FormatPrice(tech.LowestPrice)<small> /gram trở lên</small></div>
                            <ul class="tt-tierlist">
                                @foreach (var tier in tech.Tiers)
                                {
                                    <li><span>@tier.Label</span><b>@PrintPriceList.FormatPrice(tier.PricePerGram)/g</b></li>
                                }
                            </ul>
                            <a class="tt-btn tt-btn--ghost tt-btn--sm" href="@(quoteUrl)?tech=@(Uri.EscapeDataString(tech.Name))#tt-quote"><span>Báo giá @tech.Name</span> @StudioIcons.Get("arrow", "tt-arrow")</a>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section id="tt-calc" class="tt-bleed tt-section" style="padding-top:0">
            <div class="tt-wrap">
                <div class="tt-head">
                    <div>
                        <div class="tt-kicker">Tính giá tạm</div>
                        <h2 class="tt-h2 tt-split">Biết trước chi phí <span class="tt-grad">trong vài giây</span></h2>
                    </div>
                    <p class="tt-lead" data-tt-reveal>Khối lượng xem trong phần mềm slicer (Cura, PrusaSlicer, Bambu Studio, Chitubox…). Bậc giá áp dụng theo tổng khối lượng đơn in.</p>
                </div>
                <partial name="_StudioPriceCalc" model="Model.Technologies" />
            </div>
        </section>
    }

    <section id="tt-quote" class="tt-bleed tt-section" style="padding-top:0">
        <div class="tt-wrap tt-quote">
            <div data-tt-reveal>
                @if (Model.SubmittedId.HasValue)
                {
                    <div class="tt-success" role="status">
                        <span>@StudioIcons.Get("check")</span>
                        <div>
                            <h3>Đã nhận yêu cầu #@Model.SubmittedId</h3>
                            <p>Cảm ơn bạn! Chúng tôi sẽ xem file và liên hệ báo giá qua số điện thoại bạn đã để lại.</p>
                        </div>
                    </div>
                }

                <form class="tt-card tt-form" method="post" action="@quoteUrl#tt-quote" enctype="multipart/form-data" asp-antiforgery="true" data-tt-quote>
                    <honeypot />
                    <h2>Gửi file để nhận báo giá</h2>
                    <p class="tt-form-sub">Điền thông tin, đính kèm file — studio sẽ liên hệ lại. Ô có dấu <em style="color:#ff6b85;font-style:normal">*</em> là bắt buộc.</p>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <fieldset class="tt-fieldset">
                        <legend><span>1</span> Thông tin liên hệ</legend>
                        <div class="tt-row">
                            <div class="tt-field">
                                <label asp-for="Form.Name">Họ và tên <em>*</em></label>
                                <input asp-for="Form.Name" class="tt-input" autocomplete="name" />
                                <span asp-validation-for="Form.Name"></span>
                            </div>
                            <div class="tt-field">
                                <label asp-for="Form.Phone">Số điện thoại / Zalo <em>*</em></label>
                                <input asp-for="Form.Phone" class="tt-input" type="tel" autocomplete="tel" />
                                <span asp-validation-for="Form.Phone"></span>
                            </div>
                        </div>
                        <div class="tt-field">
                            <label asp-for="Form.Email">Email</label>
                            <input asp-for="Form.Email" class="tt-input" type="email" autocomplete="email" placeholder="Không bắt buộc" />
                            <span asp-validation-for="Form.Email"></span>
                        </div>
                    </fieldset>

                    <fieldset class="tt-fieldset">
                        <legend><span>2</span> Yêu cầu in</legend>
                        @if (Model.Technologies.Count > 0)
                        {
                            <div class="tt-field">
                                <label>Công nghệ in</label>
                                <div class="tt-pick">
                                    @foreach (var tech in Model.Technologies)
                                    {
                                        <label>
                                            <input type="radio" name="Form.Technology" value="@tech.Name" checked="@(tech.Name.EqualsNoCase(selectedTech))" />
                                            <span>@tech.Name<small>@tech.Materials</small></span>
                                        </label>
                                    }
                                    <label>
                                        <input type="radio" name="Form.Technology" value="Cần tư vấn" checked="@("Cần tư vấn".EqualsNoCase(selectedTech))" />
                                        <span>Chưa rõ<small>Cần tư vấn</small></span>
                                    </label>
                                </div>
                            </div>
                        }
                        <div class="tt-row-3">
                            <div class="tt-field">
                                <label asp-for="Form.Material">Màu sắc / vật liệu</label>
                                <input asp-for="Form.Material" class="tt-input" placeholder="VD: PLA trắng, Resin xám…" />
                            </div>
                            <div class="tt-field">
                                <label asp-for="Form.Quantity">Số lượng</label>
                                <input asp-for="Form.Quantity" class="tt-input" type="text" inputmode="numeric" data-numeric />
                                <span asp-validation-for="Form.Quantity"></span>
                            </div>
                            <div class="tt-field">
                                <label asp-for="Form.EstimatedGrams">Khối lượng (g)</label>
                                <input asp-for="Form.EstimatedGrams" class="tt-input" type="text" inputmode="numeric" data-numeric placeholder="Nếu biết" />
                                <span asp-validation-for="Form.EstimatedGrams"></span>
                            </div>
                        </div>
                        <div class="tt-field">
                            <label asp-for="Form.Note">Mô tả thêm</label>
                            <textarea asp-for="Form.Note" class="tt-input" rows="4" placeholder="Kích thước mong muốn, mục đích sử dụng, thời gian cần hàng, yêu cầu hoàn thiện (chà nhám, sơn, ghép phôi)…"></textarea>
                        </div>
                        <label class="tt-check">
                            <input asp-for="Form.NeedsDesign" type="checkbox" />
                            <span>Tôi cần thiết kế 3D hoặc chỉnh sửa file</span>
                        </label>
                    </fieldset>

                    <fieldset class="tt-fieldset">
                        <legend><span>3</span> File 3D</legend>
                        <div class="tt-field">
                            <div class="tt-dropzone" data-max-mb="@Model.MaxFileSizeMb">
                                <input type="file" name="modelFile" accept="@Model.AllowedExtensions" aria-label="Chọn file 3D" />
                                @StudioIcons.Get("upload")
                                <b>Kéo thả file vào đây hoặc bấm để chọn</b>
                                <small>STL, OBJ, 3MF, STEP, ZIP, ảnh… tối đa @Model.MaxFileSizeMb MB</small>
                                <span class="tt-file-name"></span>
                            </div>
                            @if (ViewData.ModelState["modelFile"]?.Errors.FirstOrDefault() is { } fileError)
                            {
                                <span class="tt-error">@fileError.ErrorMessage</span>
                            }
                        </div>
                        <div class="tt-field">
                            <label asp-for="Form.FileLink">Hoặc link tải file (Google Drive, Dropbox…)</label>
                            <input asp-for="Form.FileLink" class="tt-input" type="url" placeholder="https://" />
                            <span asp-validation-for="Form.FileLink"></span>
                        </div>
                    </fieldset>

                    <button type="submit" class="tt-btn tt-btn--block">
                        @StudioIcons.Get("upload") <span>Gửi yêu cầu báo giá</span>
                    </button>
                </form>
            </div>

            <aside class="tt-aside" data-tt-reveal="right">
                <div class="tt-card">
                    <h3>Liên hệ nhanh</h3>
                    @foreach (var p in contact.Phones)
                    {
                        <a class="tt-contact-row" href="@StudioContactModel.TelUrl(p)">@StudioIcons.Get("phone")<span><small>Hotline</small><b>@StudioContactModel.FormatPhone(p)</b></span></a>
                    }
                    @if (contact.ZaloUrl.HasValue())
                    {
                        <a class="tt-contact-row" href="@contact.ZaloUrl" target="_blank" rel="noopener">@StudioIcons.Get("chat")<span><small>Gửi file qua</small><b>Zalo</b></span></a>
                    }
                    @if (contact.FacebookUrl.HasValue())
                    {
                        <a class="tt-contact-row" href="@contact.FacebookUrl" target="_blank" rel="noopener">@StudioIcons.Get("facebook")<span><small>Nhắn tin</small><b>Facebook</b></span></a>
                    }
                </div>
                <div class="tt-card">
                    <h3>Bạn sẽ nhận được</h3>
                    <ul class="tt-list">
                        <li>@StudioIcons.Get("calc")<span><b>Báo giá theo file thực tế</b>Khối lượng, vật liệu, thời gian in.</span></li>
                        <li>@StudioIcons.Get("chat")<span><b>Tư vấn vật liệu</b>FDM hay Resin, màu sắc, cách hoàn thiện.</span></li>
                        <li>@StudioIcons.Get("truck")<span><b>Nhận hàng linh hoạt</b>Tại xưởng ở Hà Nội hoặc giao tận nơi.</span></li>
                    </ul>
                </div>
            </aside>
        </div>
    </section>
</div>
