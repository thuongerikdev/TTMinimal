@model PrintJobListModel

@{
    ViewBag.Title = T("Plugins.Split3D.PrintJob.ListTitle").Value;
    Assets.BodyAttributes.AppendCssClass("spa-layout");
}

<div class="section-header">
    <div class="title">
        <i class="bi bi-box-seam"></i>
        @ViewBag.Title
    </div>
    <div class="options">
        <a href="@Url.Action("List", "PrintQuote")" class="btn btn-secondary">
            <i class="bi bi-chat-left-text"></i>
            <span>@T("Plugins.Split3D.Studio.Quotes")</span>
        </a>
        <a href="@Url.Action("Settings", "PrintQuote")" class="btn btn-secondary">
            <i class="bi bi-gear"></i>
            <span>@T("Plugins.Split3D.Studio.Settings")</span>
        </a>
    </div>
</div>

<div class="px-3 pt-3">
    <div class="row mb-3">
        <div class="col-6 col-lg-3 mb-2">
            <div class="card card-body py-2">
                <div class="text-muted small text-uppercase">@T("Plugins.Split3D.PrintJob.ToConfirmCount")</div>
                <div class="fs-h3 font-weight-bold text-danger">@Model.ToConfirmCount.ToString("N0")</div>
            </div>
        </div>
        <div class="col-6 col-lg-3 mb-2">
            <div class="card card-body py-2">
                <div class="text-muted small text-uppercase">@T("Plugins.Split3D.PrintJob.OpenCount")</div>
                <div class="fs-h3 font-weight-bold text-primary">@Model.OpenCount.ToString("N0")</div>
            </div>
        </div>
    </div>
</div>

@{ ViewBag.SearchModel = Model; }
<partial name="_Grid.PrintJobs" model="null" />
