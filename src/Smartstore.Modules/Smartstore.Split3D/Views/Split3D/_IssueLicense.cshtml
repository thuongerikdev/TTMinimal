@model IssueLicenseModel

<form action="#" id="issue-form">
    <div class="adminContent">
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="AddonId" /></div>
            <div class="adminData"><select asp-for="AddonId" asp-items="ViewBag.AvailableAddons"></select></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="Email" /></div>
            <div class="adminData"><input asp-for="Email" type="email" required /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="CustomerName" /></div>
            <div class="adminData"><input asp-for="CustomerName" required /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="Phone" /></div>
            <div class="adminData"><input asp-for="Phone" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="KeyType" /></div>
            <div class="adminData">
                <select asp-for="KeyType" asp-items="ViewBag.AvailableKeyTypes"></select>
            </div>
        </div>
        <div class="adminRow" id="issue-days-row" style="display: none">
            <div class="adminTitle"><smart-label asp-for="Days" /></div>
            <div class="adminData"><input asp-for="Days" type="number" min="1" max="36500" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="Price" /></div>
            <div class="adminData"><input asp-for="Price" type="number" min="0" step="1000" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="PurchaseDate" /></div>
            <div class="adminData">
                <input name="PurchaseDate" id="PurchaseDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="Notes" /></div>
            <div class="adminData"><input asp-for="Notes" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="SendEmailNow" /></div>
            <div class="adminData">
                <input type="checkbox" name="SendEmailNow" id="SendEmailNow" value="true" checked class="form-check-input" />
                <input type="hidden" name="SendEmailNow" value="false" />
            </div>
        </div>
    </div>
</form>
