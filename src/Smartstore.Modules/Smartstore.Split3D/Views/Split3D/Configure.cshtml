@model ConfigurationModel

@{
    Layout = "_ConfigureModule";
}

<widget target-zone="admin_button_toolbar_before">
    <a href="@Url.Action("List")" class="btn btn-secondary">
        <i class="bi bi-key"></i>
        <span>@T("Plugins.Split3D.Licenses")</span>
    </a>
    <button id="SaveConfigButton" type="submit" name="save" class="btn btn-warning" value="save" form="split3d-config-form" data-target="#split3d-config-form">
        <i class="fa fa-check"></i>
        <span>@T("Admin.Common.Save")</span>
    </button>
</widget>

<div class="alert @(Model.KeyValid ? "alert-success" : "alert-warning")">
    <i class="bi @(Model.KeyValid ? "bi-shield-check" : "bi-exclamation-triangle") mr-1"></i>
    @Model.KeyStatus
</div>

<form asp-action="Configure" method="post" id="split3d-config-form">
    <div asp-validation-summary="All"></div>

    <div class="adminContent">
        <div class="adminRow">
            <div class="admin-config-group">
                <div class="title">@T("Plugins.Split3D.Group.Keys")</div>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="PublicKeyJson" /></div>
            <div class="adminData">
                <textarea asp-for="PublicKeyJson" rows="4" class="form-control text-monospace" spellcheck="false"></textarea>
                <span asp-validation-for="PublicKeyJson"></span>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="PrivateKeyJson" /></div>
            <div class="adminData">
                <textarea asp-for="PrivateKeyJson" rows="4" class="form-control text-monospace" spellcheck="false" autocomplete="off"
                          placeholder="@(Model.HasPrivateKey ? T("Plugins.Split3D.PrivateKeyStored") : T("Plugins.Split3D.PrivateKeyPaste"))"></textarea>
                <span asp-validation-for="PrivateKeyJson"></span>
            </div>
        </div>

        <div class="adminRow">
            <div class="admin-config-group">
                <div class="title">@T("Plugins.Split3D.Group.Products")</div>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="AutoIssueEnabled" /></div>
            <div class="adminData">
                <input asp-for="AutoIssueEnabled" />
                <span asp-validation-for="AutoIssueEnabled"></span>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"></div>
            <div class="adminData">
                <a href="@Url.Action("List", "Split3DAddon")" class="btn btn-secondary btn-sm">
                    <i class="bi bi-boxes"></i>
                    <span>@T("Plugins.Split3D.Addons.Manage")</span>
                </a>
            </div>
        </div>

        <div class="adminRow">
            <div class="admin-config-group">
                <div class="title">@T("Plugins.Split3D.Group.Devices")</div>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="ObfuscateAddons" /></div>
            <div class="adminData"><editor asp-for="ObfuscateAddons" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="PyArmorPython" /></div>
            <div class="adminData"><editor asp-for="PyArmorPython" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="PyArmorPlatforms" /></div>
            <div class="adminData"><editor asp-for="PyArmorPlatforms" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="DefaultMaxDevices" /></div>
            <div class="adminData">
                <editor asp-for="DefaultMaxDevices" />
                <span asp-validation-for="DefaultMaxDevices"></span>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="LeaseDays" /></div>
            <div class="adminData">
                <editor asp-for="LeaseDays" />
                <span asp-validation-for="LeaseDays"></span>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="CustomerDeactivationLimit" /></div>
            <div class="adminData">
                <editor asp-for="CustomerDeactivationLimit" />
                <span asp-validation-for="CustomerDeactivationLimit"></span>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="ActivationServerUrl" /></div>
            <div class="adminData">
                <input asp-for="ActivationServerUrl" placeholder="@Model.DefaultActivationServerUrl" />
                <span asp-validation-for="ActivationServerUrl"></span>
                <div class="form-text text-muted">
                    @T("Plugins.Split3D.ActivationEndpoint"):
                    <code>@(Model.ActivationServerUrl.NullEmpty() ?? Model.DefaultActivationServerUrl)/split3d/api/activate</code>
                </div>
            </div>
        </div>

        <div class="adminRow">
            <div class="admin-config-group">
                <div class="title">@T("Plugins.Split3D.Group.Payment")</div>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="BankName" /></div>
            <div class="adminData"><input asp-for="BankName" placeholder="Vietcombank" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="BankAccountNumber" /></div>
            <div class="adminData"><input asp-for="BankAccountNumber" /></div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="BankAccountHolder" /></div>
            <div class="adminData"><input asp-for="BankAccountHolder" placeholder="NGUYEN VAN A" /></div>
        </div>

        <div class="adminRow">
            <div class="admin-config-group">
                <div class="title">@T("Plugins.Split3D.Group.Email")</div>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="SendEmail" /></div>
            <div class="adminData">
                <input asp-for="SendEmail" />
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"></div>
            <div class="adminData">
                <a href="@Url.Action("Index", "StudioMail", new { area = "Admin" })" class="btn btn-secondary">
                    <i class="bi bi-envelope-paper-heart"></i>
                    <span>@T("Plugins.Split3D.Mail.EditLink")</span>
                </a>
                <div class="form-text text-muted">@T("Plugins.Split3D.Mail.EditLink.Hint")</div>
            </div>
        </div>

        <div class="adminRow">
            <div class="admin-config-group">
                <div class="title">@T("Plugins.Split3D.Group.AdminMenu")</div>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="SimplifyAdminMenu" /></div>
            <div class="adminData">
                <input asp-for="SimplifyAdminMenu" />
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle"><smart-label asp-for="HiddenAdminMenuItems" /></div>
            <div class="adminData">
                <textarea asp-for="HiddenAdminMenuItems" rows="8" class="form-control text-monospace small" spellcheck="false"></textarea>
            </div>
        </div>
    </div>
</form>
