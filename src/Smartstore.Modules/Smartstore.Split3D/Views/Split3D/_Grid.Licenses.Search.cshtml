@model LicenseListModel

<div class="form-group">
    <smart-label asp-for="SearchTerm" />
    <input asp-for="SearchTerm" />
</div>
<div class="form-group">
    <smart-label asp-for="SearchAddonId" />
    <select asp-for="SearchAddonId" asp-items="ViewBag.AvailableAddons">
        <option value="">@T("Admin.Common.All")</option>
    </select>
</div>
<div class="form-group">
    <smart-label asp-for="SearchKeyType" />
    <select asp-for="SearchKeyType" asp-items="ViewBag.AvailableKeyTypes">
        <option value="">@T("Admin.Common.All")</option>
    </select>
</div>
