<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <Product>Smartstore Split3D Licensing</Product>
        <OutputPath>..\..\Smartstore.Web\Modules\Smartstore.Split3D</OutputPath>
        <OutDir>$(OutputPath)</OutDir>
    </PropertyGroup>

    <ItemGroup>
        <!-- Licensing module injected into marketplace add-ons (Services/MarketplacePackager). -->
        <EmbeddedResource Include="Marketplace\_ttlicense.py" LogicalName="Smartstore.Split3D.Marketplace._ttlicense.py" />
        <None Remove="Marketplace\_ttlicense.py" />

        <!-- Default body of the key email message template (Services/StudioMailService). -->
        <EmbeddedResource Include="Mail\LicenseKey.liquid" LogicalName="Smartstore.Split3D.Mail.LicenseKey.liquid" />
        <None Remove="Mail\LicenseKey.liquid" />
    </ItemGroup>
</Project>
