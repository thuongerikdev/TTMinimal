<?xml version="1.0" encoding="utf-8" ?>
<Theme baseTheme="Flex" title="TT Minimal" description="TT Minimal 'Pop Studio' theme: cream background, pink / mint / yellow / lilac, thick ink outlines and hard shadows, Be Vietnam Pro (needs the Smartstore.Split3D module)" author="TT Minimal" version="4.0">
    <Vars>
        <!-- Warm grays -->
        <Var name="gray-100" type="Color">#fff7e0</Var>
        <Var name="gray-200" type="Color">#f5ecd2</Var>
        <Var name="gray-300" type="Color">#e4d9bc</Var>
        <Var name="gray-400" type="Color">#c9bea2</Var>
        <Var name="gray-500" type="Color">#9d9582</Var>
        <Var name="gray-600" type="Color">#6d685d</Var>
        <Var name="gray-700" type="Color">#4a4741</Var>
        <Var name="gray-800" type="Color">#2e2d2a</Var>
        <Var name="gray-900" type="Color">#20201f</Var>

        <!-- Pop palette -->
        <Var name="pink" type="Color">#ff67bc</Var>
        <Var name="teal" type="Color">#80e5cb</Var>
        <Var name="yellow" type="Color">#ffe348</Var>
        <Var name="purple" type="Color">#c9a6f7</Var>
        <Var name="blue" type="Color">#284be5</Var>
        <Var name="primary" type="Color">#ff67bc</Var>
        <Var name="secondary" type="Color">#6d685d</Var>
        <Var name="info" type="Color">#284be5</Var>
        <Var name="success" type="Color">#1f9a73</Var>
        <Var name="warning" type="Color">#ffe348</Var>
        <Var name="danger" type="Color">#e5484d</Var>
        <Var name="light" type="Color">#f5ecd2</Var>
        <Var name="dark" type="Color">#20201f</Var>
        <Var name="link-color" type="Color">#20201f</Var>

        <!-- Site -->
        <Var name="site-bg" type="Color">#fffbed</Var>
        <Var name="body-bg" type="Color">#fffbed</Var>
        <Var name="body-color" type="Color">#20201f</Var>
        <Var name="yiq-text-dark" type="Color">#20201f</Var>
        <Var name="body-secondary-color" type="Color">#6d685d</Var>
        <Var name="body-tertiary-color" type="Color">#9d9582</Var>
        <Var name="text-muted" type="Color">#6d685d</Var>
        <Var name="btn-secondary-bg" type="Color">#fffbed</Var>

        <!-- Components -->
        <Var name="border-radius" type="String">0.7rem</Var>
        <Var name="border-radius-sm" type="String">0.5rem</Var>
        <Var name="border-radius-lg" type="String">1rem</Var>
        <Var name="border-radius-xl" type="String">1.2rem</Var>
        <Var name="border-radius-xxl" type="String">1.5rem</Var>

        <!-- Font -->
        <Var name="google-font-1" type="String">Be+Vietnam+Pro:400,500,600,700,800,900&amp;subset=vietnamese&amp;display=swap</Var>
        <Var name="font-family-sans-serif" type="String">"Be Vietnam Pro", -apple-system, system-ui, "Segoe UI", Roboto, Arial, sans-serif</Var>
        <Var name="headings-font-family" type="String">inherit</Var>
        <Var name="headings-font-weight" type="String">900</Var>
        <Var name="font-weight-medium" type="String">700</Var>

        <!-- Header (styled in _custom.scss) -->
        <Var name="header-bg" type="Color">#fffbed</Var>
        <Var name="header-color" type="Color">#20201f</Var>
        <Var name="shopbar-color" type="Color">#20201f</Var>
        <Var name="megamenu-bg" type="Color">transparent</Var>
        <Var name="shopbar-label" type="Select#brand-colors">primary</Var>

        <!-- Search -->
        <Var name="searchbox-shadow" type="Boolean">false</Var>
        <Var name="searchbox-outline-color" type="Color">#20201f</Var>
        <Var name="searchbox-bg-1" type="Color">#ffffff</Var>
        <Var name="searchbox-bg-2" type="Color">#ffffff</Var>
        <Var name="searchbox-border-1" type="Color">#20201f</Var>
        <Var name="searchbox-border-2" type="Color">#20201f</Var>
        <Var name="searchbox-hit-tag-color" type="Color">#20201f</Var>

        <!-- Cards, dropdowns, tables -->
        <Var name="card-bg" type="Color">#ffffff</Var>
        <Var name="card-border-color" type="Color">#20201f</Var>
        <Var name="card-cap-bg" type="Color">#fff7e0</Var>
        <Var name="dropdown-bg" type="Color">#ffffff</Var>
        <Var name="dropdown-border-color" type="Color">#20201f</Var>
        <Var name="dropdown-link-hover-bg" type="Color">#fff7e0</Var>
        <Var name="table-border-color" type="Color">#e4d9bc</Var>

        <!-- Footer, catalog, checkout -->
        <Var name="inverse-footer" type="Boolean">false</Var>
        <Var name="footer-bg" type="Color">#fffbed</Var>
        <Var name="product-price-color" type="Color">#20201f</Var>
        <Var name="product-detail-addtocart-box-bg" type="Color">#ffffff</Var>
        <Var name="register-box-bg" type="Color">#ffffff</Var>
        <Var name="cart-footer-bg" type="Color">#fff7e0</Var>
        <Var name="costep-progress-color" type="Color">#ff67bc</Var>
        <Var name="offcanvas-cart-footer" type="Color">#fff7e0</Var>
        <Var name="nav-tabs-active-link-color" type="Color">#20201f</Var>
        <Var name="art-active-bg-color" type="Color">#ffffff</Var>
        <Var name="art-active-border-color" type="Color">#20201f</Var>
    </Vars>
</Theme>
