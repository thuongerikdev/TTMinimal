<?xml version="1.0" encoding="utf-8" ?>
<Theme baseTheme="Flex" title="TT Minimal" description="TT Minimal 3D printing studio theme: blue palette, Be Vietnam Pro, studio home page and footer (needs the Smartstore.Split3D module)" author="TT Minimal" version="1.0">
    <Vars>
        <!-- Colors -->
        <Var name="blue" type="Color">#2563eb</Var>
        <Var name="indigo" type="Color">#4338ca</Var>
        <Var name="cyan" type="Color">#06b6d4</Var>
        <Var name="primary" type="Color">#1d4ed8</Var>
        <Var name="secondary" type="Color">#64748b</Var>
        <Var name="info" type="Color">#0ea5e9</Var>
        <Var name="warning" type="Color">#f59e0b</Var>
        <Var name="dark" type="Color">#0b1733</Var>
        <Var name="link-color" type="Color">#1d4ed8</Var>

        <Var name="site-bg" type="Color">#ffffff</Var>
        <Var name="body-bg" type="Color">#ffffff</Var>
        <Var name="body-color" type="Color">#0b1733</Var>
        <Var name="body-secondary-color" type="Color">#5b6b8c</Var>
        <Var name="body-tertiary-color" type="Color">#94a3b8</Var>

        <!-- Components -->
        <Var name="border-radius" type="String">0.75rem</Var>
        <Var name="border-radius-sm" type="String">0.5rem</Var>
        <Var name="border-radius-lg" type="String">1rem</Var>
        <Var name="border-radius-xl" type="String">1.25rem</Var>
        <Var name="border-radius-xxl" type="String">1.75rem</Var>

        <!-- Font -->
        <Var name="google-font-1" type="String">Be+Vietnam+Pro:400,500,600,700,800&amp;subset=vietnamese&amp;display=swap</Var>
        <Var name="font-family-sans-serif" type="String">"Be Vietnam Pro", -apple-system, system-ui, "Segoe UI", Roboto, Arial, sans-serif</Var>
        <Var name="headings-font-weight" type="String">800</Var>
        <Var name="font-weight-medium" type="String">600</Var>

        <!-- Header -->
        <Var name="header-bg" type="Color">#ffffff</Var>
        <Var name="inverse-menubar" type="Boolean">true</Var>
        <Var name="menubar-bg" type="Color">#050d24</Var>
        <Var name="menubar-inverse-color" type="Color">#c7d6f5</Var>
        <Var name="megamenu-bg" type="Color">#ffffff</Var>
        <Var name="megamenu-color" type="Color">#0b1733</Var>
        <Var name="shopbar-label" type="Select#brand-colors">primary</Var>

        <!-- Search -->
        <Var name="searchbox-outline-color" type="Color">#3b82f6</Var>
        <Var name="searchbox-bg-1" type="Color">#f4f7ff</Var>
        <Var name="searchbox-border-1" type="Color">#dfe7fb</Var>
        <Var name="searchbox-hit-tag-color" type="Color">#1d4ed8</Var>

        <!-- Cards, footer, misc -->
        <Var name="card-border-color" type="Color">#dfe7fb</Var>
        <Var name="card-cap-bg" type="Color">#f4f7ff</Var>
        <Var name="inverse-footer" type="Boolean">true</Var>
        <Var name="footer-bg" type="Color">#050d24</Var>
        <Var name="product-price-color" type="Color">#1d4ed8</Var>
        <Var name="product-detail-addtocart-box-bg" type="Color">#f4f7ff</Var>
        <Var name="register-box-bg" type="Color">#f4f7ff</Var>
        <Var name="cart-footer-bg" type="Color">#f4f7ff</Var>
        <Var name="costep-progress-color" type="Color">#2563eb</Var>
        <Var name="offcanvas-cart-footer" type="Color">#1d4ed8</Var>
        <Var name="nav-tabs-active-link-color" type="Color">#1d4ed8</Var>
    </Vars>
</Theme>
