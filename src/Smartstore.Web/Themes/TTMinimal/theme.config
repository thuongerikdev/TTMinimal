<?xml version="1.0" encoding="utf-8" ?>
<Theme baseTheme="Flex" title="TT Minimal" description="TT Minimal 3D printing studio: 'Workshop' theme — warm paper background, cobalt ink, technical-drawing details, Bricolage Grotesque + Fraunces (needs the Smartstore.Split3D module)" author="TT Minimal" version="3.0">
    <Vars>
        <!-- Warm paper grays -->
        <Var name="gray-100" type="Color">#f6f4ee</Var>
        <Var name="gray-200" type="Color">#ece8de</Var>
        <Var name="gray-300" type="Color">#dcd7ca</Var>
        <Var name="gray-400" type="Color">#c2bcad</Var>
        <Var name="gray-500" type="Color">#9b968a</Var>
        <Var name="gray-600" type="Color">#6f6c66</Var>
        <Var name="gray-700" type="Color">#4c4a47</Var>
        <Var name="gray-800" type="Color">#2b2b2d</Var>
        <Var name="gray-900" type="Color">#151619</Var>

        <!-- Brand: cobalt ink -->
        <Var name="blue" type="Color">#1f3fd0</Var>
        <Var name="indigo" type="Color">#2a2fa8</Var>
        <Var name="primary" type="Color">#1f3fd0</Var>
        <Var name="secondary" type="Color">#6f6c66</Var>
        <Var name="info" type="Color">#1f3fd0</Var>
        <Var name="success" type="Color">#1f8a5b</Var>
        <Var name="warning" type="Color">#e0a21a</Var>
        <Var name="danger" type="Color">#d6402b</Var>
        <Var name="light" type="Color">#ece8de</Var>
        <Var name="dark" type="Color">#151619</Var>
        <Var name="link-color" type="Color">#1f3fd0</Var>

        <!-- Site -->
        <Var name="site-bg" type="Color">#f3f1ea</Var>
        <Var name="body-bg" type="Color">#f3f1ea</Var>
        <Var name="body-color" type="Color">#151619</Var>
        <Var name="body-secondary-color" type="Color">#6f6c66</Var>
        <Var name="body-tertiary-color" type="Color">#9b968a</Var>
        <Var name="text-muted" type="Color">#6f6c66</Var>
        <Var name="btn-secondary-bg" type="Color">#fbfaf6</Var>

        <!-- Components -->
        <Var name="border-radius" type="String">0.6rem</Var>
        <Var name="border-radius-sm" type="String">0.4rem</Var>
        <Var name="border-radius-lg" type="String">0.9rem</Var>
        <Var name="border-radius-xl" type="String">1.2rem</Var>
        <Var name="border-radius-xxl" type="String">1.6rem</Var>

        <!-- Fonts (all with Vietnamese glyphs): text, display headings, italic accent, technical labels -->
        <Var name="google-font-1" type="String">Be+Vietnam+Pro:400,500,600,700|Bricolage+Grotesque:500,600,700,800&amp;subset=vietnamese&amp;display=swap</Var>
        <Var name="google-font-2" type="String">Fraunces:400i,500i,600i&amp;subset=vietnamese&amp;display=swap</Var>
        <Var name="google-font-3" type="String">JetBrains+Mono:400,500&amp;subset=vietnamese&amp;display=swap</Var>
        <Var name="font-family-sans-serif" type="String">"Be Vietnam Pro", -apple-system, system-ui, "Segoe UI", Roboto, Arial, sans-serif</Var>
        <Var name="headings-font-family" type="String">"Bricolage Grotesque", "Be Vietnam Pro", sans-serif</Var>
        <Var name="headings-font-weight" type="String">700</Var>
        <Var name="font-weight-medium" type="String">600</Var>

        <!-- Header (styled in _custom.scss) -->
        <Var name="header-bg" type="Color">#f3f1ea</Var>
        <Var name="header-color" type="Color">#151619</Var>
        <Var name="shopbar-color" type="Color">#151619</Var>
        <Var name="megamenu-bg" type="Color">transparent</Var>
        <Var name="shopbar-label" type="Select#brand-colors">primary</Var>

        <!-- Search -->
        <Var name="searchbox-shadow" type="Boolean">false</Var>
        <Var name="searchbox-outline-color" type="Color">#1f3fd0</Var>
        <Var name="searchbox-bg-1" type="Color">#fbfaf6</Var>
        <Var name="searchbox-bg-2" type="Color">#fbfaf6</Var>
        <Var name="searchbox-border-1" type="Color">#cfc9bb</Var>
        <Var name="searchbox-border-2" type="Color">#cfc9bb</Var>
        <Var name="searchbox-hit-tag-color" type="Color">#1f3fd0</Var>

        <!-- Cards, dropdowns, tables -->
        <Var name="card-bg" type="Color">#fbfaf6</Var>
        <Var name="card-border-color" type="Color">#dcd7ca</Var>
        <Var name="card-cap-bg" type="Color">#f6f4ee</Var>
        <Var name="dropdown-bg" type="Color">#fbfaf6</Var>
        <Var name="dropdown-border-color" type="Color">#dcd7ca</Var>
        <Var name="dropdown-link-hover-bg" type="Color">#ece8de</Var>
        <Var name="table-border-color" type="Color">#dcd7ca</Var>

        <!-- Footer, catalog, checkout -->
        <Var name="inverse-footer" type="Boolean">true</Var>
        <Var name="footer-bg" type="Color">#151619</Var>
        <Var name="product-price-color" type="Color">#151619</Var>
        <Var name="product-detail-addtocart-box-bg" type="Color">#fbfaf6</Var>
        <Var name="register-box-bg" type="Color">#fbfaf6</Var>
        <Var name="cart-footer-bg" type="Color">#fbfaf6</Var>
        <Var name="costep-progress-color" type="Color">#1f3fd0</Var>
        <Var name="offcanvas-cart-footer" type="Color">#ece8de</Var>
        <Var name="nav-tabs-active-link-color" type="Color">#151619</Var>
        <Var name="art-active-bg-color" type="Color">#fbfaf6</Var>
        <Var name="art-active-border-color" type="Color">#151619</Var>
    </Vars>
</Theme>
