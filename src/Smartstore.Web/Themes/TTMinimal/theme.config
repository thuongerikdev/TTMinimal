<?xml version="1.0" encoding="utf-8" ?>
<Theme baseTheme="Flex" title="TT Minimal" description="TT Minimal 3D printing studio: dark 'Midnight Lab' theme with electric blue accents, Unbounded + Be Vietnam Pro, studio header, home page and footer (needs the Smartstore.Split3D module)" author="TT Minimal" version="2.0">
    <Vars>
        <!-- Gray scale inverted for the dark theme: 100 = darkest surface, 900 = brightest text -->
        <Var name="gray-100" type="Color">#0d1228</Var>
        <Var name="gray-200" type="Color">#131a36</Var>
        <Var name="gray-300" type="Color">#1c2548</Var>
        <Var name="gray-400" type="Color">#2b365f</Var>
        <Var name="gray-500" type="Color">#4d5886</Var>
        <Var name="gray-600" type="Color">#7c87b3</Var>
        <Var name="gray-700" type="Color">#a3acd2</Var>
        <Var name="gray-800" type="Color">#cfd6f2</Var>
        <Var name="gray-900" type="Color">#eef1ff</Var>

        <!-- Brand -->
        <Var name="blue" type="Color">#2f6bff</Var>
        <Var name="indigo" type="Color">#5b5bff</Var>
        <Var name="cyan" type="Color">#3ee0ff</Var>
        <Var name="primary" type="Color">#2f6bff</Var>
        <Var name="secondary" type="Color">#4d5886</Var>
        <Var name="info" type="Color">#3ee0ff</Var>
        <Var name="success" type="Color">#22c58b</Var>
        <Var name="warning" type="Color">#ffb020</Var>
        <Var name="danger" type="Color">#ff4d6d</Var>
        <Var name="light" type="Color">#131a36</Var>
        <Var name="dark" type="Color">#03050c</Var>
        <Var name="link-color" type="Color">#7aa2ff</Var>

        <!-- Site -->
        <Var name="site-bg" type="Color">#05070f</Var>
        <Var name="body-bg" type="Color">#05070f</Var>
        <Var name="body-color" type="Color">#dfe5fb</Var>
        <Var name="yiq-text-dark" type="Color">#05070f</Var>
        <Var name="yiq-text-light" type="Color">#ffffff</Var>
        <Var name="body-secondary-color" type="Color">#8a94bd</Var>
        <Var name="body-tertiary-color" type="Color">#5d6894</Var>
        <Var name="text-muted" type="Color">#8a94bd</Var>
        <Var name="btn-secondary-bg" type="Color">#131a36</Var>

        <!-- Components -->
        <Var name="border-radius" type="String">0.85rem</Var>
        <Var name="border-radius-sm" type="String">0.6rem</Var>
        <Var name="border-radius-lg" type="String">1.1rem</Var>
        <Var name="border-radius-xl" type="String">1.4rem</Var>
        <Var name="border-radius-xxl" type="String">2rem</Var>

        <!-- Fonts: Be Vietnam Pro for text, Unbounded for display headings (both with Vietnamese glyphs) -->
        <Var name="google-font-1" type="String">Be+Vietnam+Pro:400,500,600,700,800&amp;subset=vietnamese&amp;display=swap</Var>
        <Var name="google-font-2" type="String">Unbounded:500,600,700,800&amp;subset=vietnamese&amp;display=swap</Var>
        <Var name="font-family-sans-serif" type="String">"Be Vietnam Pro", -apple-system, system-ui, "Segoe UI", Roboto, Arial, sans-serif</Var>
        <Var name="headings-font-family" type="String">"Unbounded", "Be Vietnam Pro", sans-serif</Var>
        <Var name="headings-font-weight" type="String">700</Var>
        <Var name="font-weight-medium" type="String">600</Var>

        <!-- Header (the studio header is styled in _custom.scss) -->
        <Var name="header-bg" type="Color">transparent</Var>
        <Var name="header-color" type="Color">#dfe5fb</Var>
        <Var name="header-color-muted" type="Color">#8a94bd</Var>
        <Var name="shopbar-color" type="Color">#dfe5fb</Var>
        <Var name="megamenu-bg" type="Color">transparent</Var>
        <Var name="megamenu-color" type="Color">#dfe5fb</Var>
        <Var name="megamenu-dropdown-bg" type="Color">#0c1127</Var>
        <Var name="megamenu-heading-color" type="Color">#eef1ff</Var>
        <Var name="megamenu-text-color" type="Color">#cfd6f2</Var>
        <Var name="megamenu-rotator-bg" type="Color">rgba(12, 17, 39, 0.92)</Var>
        <Var name="shopbar-label" type="Select#brand-colors">primary</Var>

        <!-- Search -->
        <Var name="searchbox-shadow" type="Boolean">false</Var>
        <Var name="searchbox-outline-color" type="Color">#2f6bff</Var>
        <Var name="searchbox-bg-1" type="Color">#0c1127</Var>
        <Var name="searchbox-bg-2" type="Color">#0c1127</Var>
        <Var name="searchbox-bg-mobile" type="Color">#0c1127</Var>
        <Var name="searchbox-color-1" type="Color">#dfe5fb</Var>
        <Var name="searchbox-color-2" type="Color">#dfe5fb</Var>
        <Var name="searchbox-border-1" type="Color">#1f2850</Var>
        <Var name="searchbox-border-2" type="Color">#1f2850</Var>
        <Var name="searchbox-border-mobile" type="Color">#1f2850</Var>
        <Var name="searchbox-hit-tag-color" type="Color">#7aa2ff</Var>

        <!-- Cards, dropdowns, tables -->
        <Var name="card-bg" type="Color">#0b1026</Var>
        <Var name="card-border-color" type="Color">#1b2448</Var>
        <Var name="card-cap-bg" type="Color">#0e1430</Var>
        <Var name="dropdown-bg" type="Color">#0c1127</Var>
        <Var name="dropdown-color" type="Color">#dfe5fb</Var>
        <Var name="dropdown-border-color" type="Color">#1f2850</Var>
        <Var name="dropdown-divider-bg" type="Color">#1f2850</Var>
        <Var name="dropdown-link-color" type="Color">#cfd6f2</Var>
        <Var name="dropdown-link-hover-color" type="Color">#ffffff</Var>
        <Var name="dropdown-link-hover-bg" type="Color">#161e40</Var>
        <Var name="table-accent-bg" type="Color">rgba(255, 255, 255, 0.025)</Var>
        <Var name="table-hover-bg" type="Color">rgba(255, 255, 255, 0.05)</Var>
        <Var name="table-border-color" type="Color">#1b2448</Var>

        <!-- Footer, catalog, checkout -->
        <Var name="inverse-footer" type="Boolean">true</Var>
        <Var name="footer-bg" type="Color">#03050c</Var>
        <Var name="product-price-color" type="Color">#ffffff</Var>
        <Var name="product-detail-addtocart-box-bg" type="Color">#0b1026</Var>
        <Var name="register-box-bg" type="Color">#0b1026</Var>
        <Var name="cart-footer-bg" type="Color">#0b1026</Var>
        <Var name="costep-progress-color" type="Color">#2f6bff</Var>
        <Var name="offcanvas-cart-footer" type="Color">#0e1430</Var>
        <Var name="nav-tabs-active-link-color" type="Color">#ffffff</Var>
        <Var name="art-active-bg-color" type="Color">#0b1026</Var>
        <Var name="art-active-border-color" type="Color">#2b365f</Var>
    </Vars>
</Theme>
