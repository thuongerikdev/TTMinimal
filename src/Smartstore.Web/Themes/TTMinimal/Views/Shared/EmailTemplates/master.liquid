<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
	<head>
		{% comment %}
			TT Minimal "Pop Studio" email layout. Colors come from the Theme model part, the layout knobs
			from the Studio model part (Smartstore.Split3D > TT Minimal Studio > Email). Without the Studio
			part (module disabled) the layout falls back to the "pop" look with the Theme colors.
		{% endcomment %}
		{% assign _left = "left" %}
		{% assign _right = "right" %}
		{% if Context.LanguageRtl %}
			{% assign _left = "right" %}
			{% assign _right = "left" %}
		{% endif %}
		{% assign _layout = "pop" %}
		{% assign _header = "ink" %}
		{% if Studio and Studio.Layout %}{% assign _layout = Studio.Layout %}{% endif %}
		{% if Studio and Studio.HeaderStyle %}{% assign _header = Studio.HeaderStyle %}{% endif %}
		{% assign _ink = Theme.TitleColor %}
		{% assign _accent = Theme.BrandPrimary %}
		{% assign _highlight = Theme.BrandWarning %}
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
		<meta name="x-apple-disable-message-reformatting" />
		<title>{{ Email.Subject }}</title>
		<style type="text/css" rel="stylesheet" media="all">

			/* Base ------------------------------ */
			*:not(br):not(tr):not(html) {
				font-family: {{ Theme.FontFamily }};
				box-sizing: border-box;
			}

			body {
				width: 100% !important;
				height: 100%;
				margin: 0;
				padding: 0;
				font-size: 15px;
				line-height: 1.6;
				background-color: {{ Theme.BodyBg }};
				color: {{ Theme.BodyColor }};
				-webkit-text-size-adjust: none;
			}

			p, ul, ol, blockquote { line-height: 1.6; }
			a { color: {{ _ink }}; font-weight: 600; }
			img { outline: none; text-decoration: none; border: 0; -ms-interpolation-mode: bicubic; }
			td { word-break: break-word; color: {{ Theme.BodyColor }}; }
			p:last-child { margin-bottom: 0; }

			table { border-spacing: 0; border-collapse: separate; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
			table.w-100 { width: 100%; -premailer-width: 100%; }
			th, td { text-align: {{ _left }}; }
			td { vertical-align: top; -premailer-valign: top; }
			tr.valign-top td, tr.valign-top th { vertical-align: top; -premailer-valign: top; }
			tr.valign-middle td, tr.valign-middle th { vertical-align: middle; -premailer-valign: middle; }
			tr.valign-bottom td, tr.valign-bottom th { vertical-align: bottom; -premailer-valign: bottom; }

			/* Layout ------------------------------ */

			.wrapper {
				width: 100%;
				margin: 0;
				padding: 0;
				background-color: {{ Theme.BodyBg }};
				-premailer-width: 100%;
				-premailer-cellpadding: 0;
				-premailer-cellspacing: 0;
			}

			.wrapper-cell { padding: 28px 12px 36px; }

			.container {
				width: 600px;
				margin: 0 auto;
				-premailer-width: 600px;
				-premailer-cellpadding: 0;
				-premailer-cellspacing: 0;
				-premailer-align: center;
			}

			/* Masthead ----------------------- */

			.masthead {
				width: 100%;
				-premailer-width: 100%;
				-premailer-cellpadding: 0;
				-premailer-cellspacing: 0;
			}

			.masthead-cell { padding: 16px 22px; vertical-align: middle; -premailer-valign: middle; }
			.masthead-note-cell { padding: 16px 22px; vertical-align: middle; -premailer-valign: middle; text-align: {{ _right }}; -premailer-align: {{ _right }}; }

			.masthead-ink { background-color: {{ _ink }}; border-radius: 16px; }
			.masthead-accent { background-color: {{ _accent }}; border: 2px solid {{ _ink }}; border-radius: 16px; }
			.masthead-light { background-color: transparent; border-bottom: 2px solid {{ _ink }}; }

			.brand {
				font-size: 21px;
				font-weight: 900;
				letter-spacing: -0.02em;
				line-height: 1.1;
				text-decoration: none;
			}

			.brand-dot {
				display: inline-block;
				width: 12px;
				height: 12px;
				border-radius: 4px;
				margin-{{ _right }}: 8px;
				vertical-align: 1px;
				background-color: {{ _accent }};
				border: 2px solid {{ _ink }};
			}

			.masthead-ink .brand { color: {{ Theme.BodyBg }}; }
			.masthead-ink .brand-dot { border-color: {{ Theme.BodyBg }}; }
			.masthead-ink .masthead-note { color: {{ Theme.BodyBg }}; }
			.masthead-accent .brand,
			.masthead-accent .masthead-note,
			.masthead-light .brand,
			.masthead-light .masthead-note { color: {{ _ink }}; }
			.masthead-accent .brand-dot { background-color: {{ _highlight }}; }

			.masthead-note { font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; opacity: 0.85; }
			.masthead-logo { max-height: 44px; }

			/* Card ------------------------------ */

			.spacer { height: 18px; line-height: 18px; font-size: 1px; }

			.card {
				width: 100%;
				background-color: {{ Theme.ContentBg }};
				-premailer-width: 100%;
				-premailer-cellpadding: 0;
				-premailer-cellspacing: 0;
			}

			.card-pop {
				border: 2px solid {{ _ink }};
				border-radius: 18px;
				box-shadow: 6px 6px 0 {{ _ink }};
			}

			.card-clean {
				border: 1px solid {{ Theme.ShadeColor }};
				border-radius: 14px;
				box-shadow: 0 10px 30px rgba(32, 32, 31, 0.06);
			}

			.card-accent { height: 6px; line-height: 6px; font-size: 1px; background-color: {{ _accent }}; border-radius: 16px 16px 0 0; }
			.card-pop .card-accent { border-bottom: 2px solid {{ _ink }}; }

			.content-cell { padding: 34px 36px 36px; }
			.content-cell > *:last-child { margin-bottom: 0; }

			/* Footer ------------------------------ */

			.footer {
				width: 100%;
				-premailer-width: 100%;
				-premailer-cellpadding: 0;
				-premailer-cellspacing: 0;
			}

			.footer-cell { padding: 26px 22px 0; text-align: center; -premailer-align: center; }
			.footer-cell p { color: {{ Theme.MutedColor }}; font-size: 13px; }
			.footer-note { color: {{ Theme.BodyColor }} !important; font-size: 14px !important; margin: 0 0 14px; }
			.footer-contact { margin: 0 0 14px; }
			.footer-copy { font-size: 12px !important; margin: 14px 0 0; }

			.chip {
				display: inline-block;
				margin: 0 3px 6px;
				padding: 5px 12px;
				border: 2px solid {{ _ink }};
				border-radius: 999px;
				background-color: {{ Theme.ContentBg }};
				color: {{ _ink }} !important;
				font-size: 12px;
				font-weight: 700;
				text-decoration: none;
			}

			/* Studio blocks (key email and other studio templates) ------------------------------ */

			.eyebrow {
				display: inline-block;
				margin: 0 0 14px;
				padding: 4px 12px;
				border: 2px solid {{ _ink }};
				border-radius: 999px;
				background-color: {{ _highlight }};
				color: {{ _ink }};
				font-size: 11px;
				font-weight: 800;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			.lead { font-size: 16px; color: {{ Theme.BodyColor }}; margin: 0 0 22px; }

			.facts {
				width: 100%;
				margin: 0 0 22px;
				border: 2px solid {{ _ink }};
				border-radius: 14px;
				-premailer-width: 100%;
				-premailer-cellpadding: 0;
				-premailer-cellspacing: 0;
			}

			.fact { padding: 12px 16px; width: 50%; border-bottom: 1px dashed {{ Theme.ShadeColor }}; }
			.fact-last { border-bottom: 0; }
			.fact-label { display: block; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: {{ Theme.MutedColor }}; }
			.fact-value { display: block; font-size: 15px; font-weight: 800; color: {{ _ink }}; }

			.keybox {
				width: 100%;
				margin: 0 0 8px;
				background-color: {{ _highlight }};
				border: 2px solid {{ _ink }};
				border-radius: 14px;
				-premailer-width: 100%;
				-premailer-cellpadding: 0;
				-premailer-cellspacing: 0;
			}

			.keybox-cell { padding: 16px 18px 18px; }
			.keybox-label { margin: 0 0 8px; font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: {{ _ink }}; }

			.keybox-code {
				display: block;
				padding: 12px 14px;
				background-color: #ffffff;
				border: 2px dashed {{ _ink }};
				border-radius: 10px;
				color: {{ _ink }};
				font-family: Consolas, "SFMono-Regular", Menlo, "Courier New", monospace !important;
				font-size: 13px;
				line-height: 1.5;
				word-break: break-all;
			}

			.keybox-hint { margin: 0 0 24px; font-size: 12px; color: {{ Theme.MutedColor }}; }

			.download {
				width: 100%;
				margin: 0 0 8px;
				background-color: {{ Theme.BodyBg }};
				border: 2px solid {{ _ink }};
				border-radius: 14px;
				-premailer-width: 100%;
				-premailer-cellpadding: 0;
				-premailer-cellspacing: 0;
			}

			.download-cell { padding: 20px 18px 18px; text-align: center; -premailer-align: center; }
			.download-label { margin: 0 0 4px; font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: {{ Theme.MutedColor }}; }
			.download-name { margin: 0; font-size: 17px; font-weight: 900; color: {{ _ink }}; word-break: break-all; }
			.download-meta { margin: 2px 0 16px; font-size: 13px; color: {{ Theme.MutedColor }}; }
			.download-hint { margin: 14px 0 0; font-size: 12px; color: {{ Theme.MutedColor }}; }

			.steps {
				width: 100%;
				margin: 0 0 8px;
				-premailer-width: 100%;
				-premailer-cellpadding: 0;
				-premailer-cellspacing: 0;
			}

			.step-no-cell { width: 44px; padding: 0 0 14px; }

			.step-no {
				display: inline-block;
				width: 30px;
				height: 30px;
				line-height: 26px;
				text-align: center;
				border: 2px solid {{ _ink }};
				border-radius: 999px;
				background-color: {{ _accent }};
				color: {{ _ink }};
				font-size: 14px;
				font-weight: 900;
			}

			.step-text { padding: 3px 0 14px; font-size: 15px; }
			.step-text b { color: {{ _ink }}; }

			.note {
				width: 100%;
				margin: 18px 0 0;
				background-color: {{ Theme.BodyBg }};
				border-radius: 12px;
				-premailer-width: 100%;
				-premailer-cellpadding: 0;
				-premailer-cellspacing: 0;
			}

			.note-cell { padding: 12px 16px; font-size: 13px; color: {{ Theme.MutedColor }}; }

			/* Shared classes of the core templates (order, address, shipment) ------------------------------ */

			.attributes { margin: 0 0 21px; }
			.attributes-content { background-color: {{ Theme.BodyBg }}; padding: 16px; border-radius: 12px; }
			.attributes-item { padding: 0; }

			.discount {
				width: 100%;
				margin: 0;
				padding: 24px;
				background-color: {{ _highlight }};
				border: 2px dashed {{ _ink }};
				border-radius: 14px;
			}

			.discount-heading, .discount-body { text-align: center; }

			.purchase-heading { padding-bottom: 8px; border-bottom: 1px solid {{ Theme.ShadeColor }}; }
			.purchase-heading p { margin: 0; color: {{ Theme.MutedColor }}; font-size: 12px; }
			.purchase-footer { padding-top: 15px; border-top: 1px solid {{ Theme.ShadeColor }}; }
			.purchase-total { margin: 0; text-align: {{ _right }}; font-weight: 800; color: {{ _ink }}; }

			.order-items td, .order-items th { padding: 10px 8px; border-bottom: 1px solid {{ Theme.ShadeColor }}; }
			.order-summary { border-radius: 12px; }
			.order-summary td { padding: 6px 10px; }
			.order-item-link { font-weight: 700; color: {{ _ink }}; text-decoration: none; }

			/* Utilities ------------------------------ */

			.m-0 { margin: 0px; } .m-1 { margin: 5px; } .m-2 { margin: 10px; } .m-3 { margin: 20px; } .m-4 { margin: 35px; } .m-5 { margin: 64px; }
			.mt-0 { margin-top: 0px; } .mt-1 { margin-top: 4px; } .mt-2 { margin-top: 8px; } .mt-3 { margin-top: 16px; } .mt-4 { margin-top: 32px; } .mt-5 { margin-top: 64px; }
			.mb-0 { margin-bottom: 0px; } .mb-1 { margin-bottom: 4px; } .mb-2 { margin-bottom: 8px; } .mb-3 { margin-bottom: 16px; } .mb-4 { margin-bottom: 32px; } .mb-5 { margin-bottom: 64px; }
			.p-0 { padding: 0px; } .p-1 { padding: 5px; } .p-2 { padding: 10px; } .p-3 { padding: 20px; } .p-4 { padding: 35px; } .p-5 { padding: 64px; }
			.pt-0 { padding-top: 0px; } .pt-1 { padding-top: 4px; } .pt-2 { padding-top: 8px; } .pt-3 { padding-top: 16px; } .pt-4 { padding-top: 32px; } .pt-5 { padding-top: 64px; }
			.pb-0 { padding-bottom: 0px; } .pb-1 { padding-bottom: 4px; } .pb-2 { padding-bottom: 8px; } .pb-3 { padding-bottom: 16px; } .pb-4 { padding-bottom: 32px; } .pb-5 { padding-bottom: 64px; }

			.brd { border: 1px solid {{ Theme.ShadeColor }}; border-radius: 12px; }
			.bg-light { background-color: {{ Theme.BodyBg }}; }
			.bg-primary { background-color: {{ _accent }}; }
			.bg-warning { background-color: {{ _highlight }}; }
			.bg-success { background-color: {{ Theme.BrandSuccess }}; }
			.bg-danger { background-color: {{ Theme.BrandDanger }}; }

			/* Buttons ------------------------------ */

			.btn {
				display: inline-block;
				color: {{ _ink }} !important;
				text-decoration: none;
				font-size: 15px;
				font-weight: 800;
				border-radius: 999px;
				-webkit-text-size-adjust: none;
			}

			.btn-primary, .btn-success, .btn-warning, .btn-danger {
				padding: 12px 26px;
				border: 2px solid {{ _ink }};
				box-shadow: 3px 3px 0 {{ _ink }};
			}

			.btn-primary { background-color: {{ _accent }}; }
			.btn-lg { padding: 15px 34px; font-size: 17px; font-weight: 900; }
			.btn-success { background-color: {{ Theme.BrandSuccess }}; color: #ffffff !important; }
			.btn-warning { background-color: {{ _highlight }}; }
			.btn-danger { background-color: {{ Theme.BrandDanger }}; color: #ffffff !important; }

			/* Typo ------------------------------ */

			body, p, td, th { font-size: 15px; }
			b, strong, th { font-weight: 700; }
			th { color: {{ _ink }}; }

			h1 { margin: 0 0 14px; color: {{ _ink }}; font-size: 26px; font-weight: 900; line-height: 1.2; letter-spacing: -0.02em; }
			h2 { margin: 26px 0 12px; color: {{ _ink }}; font-size: 18px; font-weight: 800; line-height: 1.25; }
			h3 { margin: 0 0 8px; color: {{ _ink }}; font-size: 15px; font-weight: 800; line-height: 1.25; }
			p { margin-top: 0; color: {{ Theme.BodyColor }}; line-height: 1.6; }

			.message { font-style: italic; }

			.text-right { text-align: {{ _right }}; }
			.text-left { text-align: {{ _left }}; }
			.text-center { text-align: center; }
			th.text-right, td.text-right { -premailer-align: {{ _right }}; }
			th.text-left, td.text-left { -premailer-align: {{ _left }}; }
			th.text-center, td.text-center { -premailer-align: center; }

			.text-primary { color: {{ _ink }}; }
			.text-warning { color: {{ Theme.BrandWarning }}; }
			.text-success { color: {{ Theme.BrandSuccess }}; }
			.text-danger { color: {{ Theme.BrandDanger }}; }
			.text-white { color: #fff; }
			.text-sm { font-size: 13px; }
			.text-xs { font-size: 12px; }
			.text-lg { font-size: 17px; }
			.text-xl { font-size: 22px; }

			.text-muted, .text-muted-all { color: {{ Theme.MutedColor }}; }
			.text-muted-all p, .text-muted-all h1, .text-muted-all h2, .text-muted-all h3, .text-muted-all td, .text-muted-all th { color: inherit; }

			{% zone 'css' %}
		</style>
	</head>
	<body{% if Context.LanguageRtl %} dir="rtl"{% endif %}>

	<style type="text/css" id="ignore">
		@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700;800;900&display=swap');

		#outlook a { padding: 0; }
		body { width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; margin: 0; padding: 0; }
		.ExternalClass { width: 100%; }
		.ExternalClass, .ExternalClass p, .ExternalClass span, .ExternalClass font, .ExternalClass td, .ExternalClass div { line-height: 100%; }
		.ReadMsgBody { width: 100%; }

		@media only screen and (max-width: 640px) {
			.container { width: 100% !important; }
			.content-cell { padding: 26px 20px 28px !important; }
			.wrapper-cell { padding: 16px 8px 28px !important; }
			.masthead-note-cell { display: none !important; }
			.fact { display: block !important; width: 100% !important; }
			h1 { font-size: 22px !important; }
		}
	</style>

	{% block 'wrapper_before' %}{% endblock %}
	{% zone 'wrapper_before' %}

	<table class="wrapper" role="presentation">
		<tr>
			<td class="wrapper-cell" align="center">
				<table class="container" role="presentation">
					<tr>
						<td>
							{% block 'header_before' %}{% endblock %}
							{% zone 'header_before' %}
							{% block 'header' %}
								{% include 'header' %}
							{% endblock %}
							{% block 'header_after' %}{% endblock %}
							{% zone 'header_after' %}
						</td>
					</tr>
					<tr><td class="spacer">&nbsp;</td></tr>
					<tr>
						<td>
							<table class="card card-{{ _layout }}" role="presentation">
								<tr><td class="card-accent">&nbsp;</td></tr>
								<tr>
									<td class="content-cell">
										{% block 'body_before' %}{% endblock %}
										{% zone 'body_before' %}
										{% block 'body' %}{% endblock %}
										{% block 'body_after' %}{% endblock %}
										{% zone 'body_after' %}
									</td>
								</tr>
							</table>
						</td>
					</tr>
					<tr>
						<td>
							<table class="footer" role="presentation">
								<tr>
									<td class="footer-cell">
										{% block 'footer_before' %}{% endblock %}
										{% zone 'footer_before' %}
										{% block 'footer' %}
											{% include 'footer' %}
										{% endblock %}
										{% block 'footer_after' %}{% endblock %}
										{% zone 'footer_after' %}
									</td>
								</tr>
							</table>
						</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>

	{% block 'wrapper_after' %}{% endblock %}
	{% zone 'wrapper_after' %}

	</body>
</html>
