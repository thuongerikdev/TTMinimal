@model ShopBarModel

@inject IModuleCatalog ModuleCatalog

@{
    var studioModule = ModuleCatalog.GetModuleByName("Smartstore.Split3D");
    var hasStudio = studioModule != null && studioModule.IsInstalled();
}

@* TT Minimal header row. ShopBar.Tools keeps Flex's cart / wishlist / offcanvas behaviour. *@
<div class="shopbar tt-shopbar">
    <div class="shopbar-col shop-logo">
        @await Component.InvokeAsync("ShopLogo")
    </div>

    @if (hasStudio)
    {
        <nav class="tt-mainnav d-none d-lg-flex" aria-label="@T("Aria.Label.MainNavigation")">
            @(await new Smartstore.Core.Widgets.ComponentWidget("StudioNav", "Smartstore.Split3D", null).InvokeAsync(ViewContext))
        </nav>
    }

    <div class="tt-shopbar-end">
        <div class="tt-search" id="tt-search">
            <button type="button" class="tt-icon-btn tt-search-toggle" aria-expanded="false" aria-controls="tt-search-panel" aria-label="@T("Search")">
                <i class="fa fa-magnifying-glass" aria-hidden="true"></i>
            </button>
            <div class="tt-search-panel" id="tt-search-panel">
                <zone name="searchbox" replace-content="true">
                    @await Component.InvokeAsync("SearchBox")
                </zone>
            </div>
        </div>

        @if (Model.DisplayAdminLink)
        {
            <a class="tt-icon-btn d-none d-lg-inline-flex" asp-area="Admin" asp-controller="Home" asp-action="Index" target="_admin" rel="nofollow" title="@T("Account.Administration")" aria-label="@T("Account.Administration")">
                <i class="fa fa-gear" aria-hidden="true"></i>
            </a>
        }

        @* Account: Flex shows this in the TopBar (which TT Minimal drops). The dropdown carries the logout link. *@
        @if (Model.IsAuthenticated)
        {
            <div class="dropdown tt-account">
                <a class="tt-icon-btn" href="@Url.Action("Info", "Customer")" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" rel="nofollow" title="@T("Account.MyAccount")" aria-label="@T("Account.MyAccount")">
                    <i class="fa fa-user" aria-hidden="true"></i>
                </a>
                @await Component.InvokeAsync("AccountDropdown")
            </div>
        }
        else
        {
            <a class="tt-icon-btn" href="@Url.RouteUrl("Login", new { returnUrl = Context.Request.Query["returnUrl"].ToString() })" rel="nofollow" title="@T("Account.Login")" aria-label="@T("Account.Login")">
                <i class="fa fa-user" aria-hidden="true"></i>
            </a>
        }

        <div class="shopbar-col-group shopbar-col-group-tools">
            <partial name="ShopBar.Tools" model="Model" />
        </div>
    </div>
</div>
