@model FaviconModel

@* TT Minimal browser icons ("tt" on pink). Files live in the Split3D module; an icon uploaded in the admin area is not used. *@
@{
    const string root = "~/Modules/Smartstore.Split3D/studio/";
    const string v = "?v=2";
}

<link rel="icon" type="image/svg+xml" href="@Url.Content(root + "favicon.svg" + v)" />
<link rel="icon" type="image/png" sizes="32x32" href="@Url.Content(root + "favicon-32.png" + v)" />
<link rel="icon" type="image/png" sizes="192x192" href="@Url.Content(root + "icon-192.png" + v)" />
<link rel="shortcut icon" href="@Url.Content(root + "favicon.ico" + v)" />
<link rel="apple-touch-icon" sizes="180x180" href="@Url.Content(root + "apple-touch-icon.png" + v)" />
<meta name="theme-color" content="#ff67bc" />
@* Declare dark support so browsers with forced/auto dark mode (Chrome, Samsung Internet) leave the page alone instead
   of inverting it. The page paints its own (light) colors in both schemes, see _custom.scss. *@
<meta name="color-scheme" content="light dark" />
<meta name="supported-color-schemes" content="light dark" />
